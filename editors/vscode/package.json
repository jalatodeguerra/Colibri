{
  "name": "colibri",
  "displayName": "Colibri",
  "description": "Syntax highlighting and language server support for the Colibri programming language",
  "version": "0.1.0",
  "publisher": "colibri-lang",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/jalatodeguerra/leo"
  },
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "languages": [
      {
        "id": "colibri",
        "aliases": [
          "Colibri",
          "colibri"
        ],
        "extensions": [
          ".colibri"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "colibri",
        "scopeName": "source.colibri",
        "path": "./syntaxes/colibri.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "Colibri",
      "properties": {
        "colibri.server.path": {
          "type": "string",
          "default": "colibri",
          "description": "The `colibri` executable that runs `colibri lsp`."
        },
        "colibri.interfaces": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Interface files (`.cbi`) describing what the host program provides, relative to the workspace folder. `.cbi` files next to a `colibri.toml` are found without being listed. Restart the server after changing."
        }
      }
    }
  },
  "main": "./extension.js",
  "activationEvents": [
    "onLanguage:colibri"
  ],
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  }
}
