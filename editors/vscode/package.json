{
  "name": "colibri",
  "displayName": "Colibri",
  "description": "Syntax highlighting for the Colibri programming language",
  "version": "0.1.0",
  "publisher": "colibri-lang",
  "license": "MIT OR Apache-2.0",
  "repository": { "type": "git", "url": "https://github.com/jalatodeguerra/leo" },
  "engines": { "vscode": "^1.80.0" },
  "categories": ["Programming Languages"],
  "contributes": {
    "languages": [
      {
        "id": "colibri",
        "aliases": ["Colibri", "colibri"],
        "extensions": [".colibri"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "colibri",
        "scopeName": "source.colibri",
        "path": "./syntaxes/colibri.tmLanguage.json"
      }
    ]
  }
}
