// Value-type structs updated in place through a `mut self` method.
struct P {
    x: float
    y: float
    vx: float
    vy: float
}

impl P {
    fn step(mut self, dt: float) {
        self.x += self.vx * dt
        self.y += self.vy * dt
    }
}

fn main() {
    let mut ps: List[P] = []
    for i in 0..1000 {
        ps.push(P { x: 0.0, y: 0.0, vx: 1.0, vy: 2.0 })
    }
    for round in 0..300 {
        for mut p in ps {
            p.step(0.016)
        }
    }
    print(ps[0].x)
}
