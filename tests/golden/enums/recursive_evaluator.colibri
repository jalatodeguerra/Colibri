enum Expr {
    Num(int)
    Add(Expr, Expr)
    Mul(Expr, Expr)
    Neg(Expr)
}

fn eval(e: Expr) -> int {
    return match e {
        Num(n) => n
        Add(a, b) => eval(a) + eval(b)
        Mul(a, b) => eval(a) * eval(b)
        Neg(a) => -eval(a)
    }
}

fn main() {
    let e = Expr.Add(.Num(2), .Mul(.Num(3), .Neg(.Num(4))))
    print(eval(e))
    print(e)
}

// expect: -10
// expect: Add(Num(2), Mul(Num(3), Neg(Num(4))))
