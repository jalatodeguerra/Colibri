fn check(n: int) -> Result[int, str] {
    if n == 3 { return err("three") }
    return ok(n)
}
fn all(limit: int) -> Result[int, str] {
    let mut total = 0
    for i in 0..limit {
        total += check(i)?
        print("added {i}")
    }
    return ok(total)
}
print(all(3))
print(all(6))
// expect: added 0
// expect: added 1
// expect: added 2
// expect: ok(3)
// expect: added 0
// expect: added 1
// expect: added 2
// expect: err("three")
