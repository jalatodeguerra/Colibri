fn half(n: int) -> Result[int, str] {
    if n % 2 != 0 { return err("odd {n}") }
    return ok(n / 2)
}
let quarter = fn(n: int) -> Result[int, str] {
    let h = half(n)?
    return half(h)
}
print(quarter(8))
print(quarter(6))
print(quarter(7))
let opt = fn(n: int) -> int? {
    let v = if n > 0 { some(n) } else { none }
    let w = v?
    return some(w + 1)
}
print(opt(1))
print(opt(0))
// expect: ok(2)
// expect: err("odd 3")
// expect: err("odd 7")
// expect: some(2)
// expect: none
