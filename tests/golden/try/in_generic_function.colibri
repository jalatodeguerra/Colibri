fn first_even[T](items: List[T], f: fn(T) -> bool) -> Result[T, str] {
    for x in items {
        if f(x) { return ok(x) }
    }
    return err("none matches")
}
fn double_first(items: List[int]) -> Result[int, str] {
    let v = first_even(items, fn(x) => x % 2 == 0)?
    return ok(v * 2)
}
print(double_first([1, 3, 4]))
print(double_first([1, 3]))
// expect: ok(8)
// expect: err("none matches")
