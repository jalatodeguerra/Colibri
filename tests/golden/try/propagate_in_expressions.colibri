fn num(n: int) -> Result[int, str] {
    if n < 0 { return err("negative: {n}") }
    return ok(n)
}
fn calc(a: int, b: int) -> Result[int, str] {
    let total = num(a)? + num(b)? * 2
    return ok(total)
}
fn nested(a: int) -> Result[int, str] {
    return ok(num(num(a)?)? + 1)
}
print(calc(1, 2))
print(calc(-1, 2))
print(calc(1, -2))
print(nested(5))
print(nested(-5))
// expect: ok(5)
// expect: err("negative: -1")
// expect: err("negative: -2")
// expect: ok(6)
// expect: err("negative: -5")
