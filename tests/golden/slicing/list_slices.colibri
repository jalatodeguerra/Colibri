fn main() {
    let xs = [10, 20, 30, 40, 50]
    print(xs[1..3])
    print(xs[..2])
    print(xs[2..])
    print(xs[..])
    print(xs[1..=3])
    print(xs[..=0])
    print(xs[5..])
    print(xs[2..2])
}

// expect: [20, 30]
// expect: [10, 20]
// expect: [30, 40, 50]
// expect: [10, 20, 30, 40, 50]
// expect: [20, 30, 40]
// expect: [10]
// expect: []
// expect: []
