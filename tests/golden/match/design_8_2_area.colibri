// DESIGN §8.2, with `math.PI` replaced by a literal and `0` by `0.0`
// (`int` never converts to `float`, and there is no `math` module yet).
enum Shape {
    Circle(float)
    Rect(float, float)
    Point
}

fn area(s: Shape) -> float {
    return match s {
        Circle(r)    => 3.0 * r * r
        Rect(w, h)   => w * h
        Point        => 0.0
    }
}

fn main() {
    print(area(.Circle(2.0)))
    print(area(.Rect(3.0, 4.5)))
    print(area(.Point))
}

// expect: 12.0
// expect: 13.5
// expect: 0.0
