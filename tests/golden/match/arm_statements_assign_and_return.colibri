fn first_even(a: int, b: int) -> int {
    match a % 2 {
        0 => return a
        _ => {}
    }
    match b % 2 {
        0 => return b
        _ => return -1
    }
}

fn main() {
    let mut total = 0
    let mut i = 0
    while i < 6 {
        match i % 3 {
            0 => total += 10
            1 => total += 1
            _ => total = total
        }
        i += 1
    }
    print(total)
    print(first_even(3, 4))
    print(first_even(3, 5))
    print(first_even(2, 5))
}

// expect: 22
// expect: 4
// expect: -1
// expect: 2
