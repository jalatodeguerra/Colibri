// allow: unused
class Bad { name: str, n: int }

impl Drop for Bad {
    fn drop(self) {
        print("drop {self.name}")
        let zero = 0
        print(1 / zero)
    }
}

fn mk() -> Bad => Bad { name: "guard", n: 1 }

// The guard's temporary dies when the guard ends; its panicking hook is thrown right there,
// so the arm body never runs.
fn main() {
    match 5 {
        n if mk().n > 0 => print("body {n}")
        _ => print("other")
    }
    print("not reached")
}

// expect: drop guard
// panic: division by zero
// drops: guard
