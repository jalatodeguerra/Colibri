fn describe(n: int) -> str {
    return match n {
        0 => "zero"
        1 => "one"
        -1 => "minus one"
        _ => "many"
    }
}

fn main() {
    print(describe(0))
    print(describe(1))
    print(describe(-1))
    print(describe(42))
}

// expect: zero
// expect: one
// expect: minus one
// expect: many
