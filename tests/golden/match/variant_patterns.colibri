enum Shape { Circle(float), Rect(float, float), Dot }

fn area(s: Shape) -> float {
    return match s {
        Circle(r) => 3.0 * r * r
        Rect(w, h) => w * h
        Dot => 0.0
    }
}

fn main() {
    print(area(.Circle(2.0)))
    print(area(.Rect(2.0, 3.5)))
    print(area(.Dot))
}

// expect: 12.0
// expect: 7.0
// expect: 0.0
