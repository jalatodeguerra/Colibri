// only: windows - starts programs with `cmd` and `ping`; process_spawn.colibri is the Unix counterpart
// caps: os
// `spawn` starts a program and returns at once: poll it with `try_wait` and collect it with
// `join`. The text a program writes keeps its own line ends (`cmd` writes `\r\n`), so this
// golden trims it.
import process

fn main() {
    let child = process.spawn("cmd", ["/C", "exit", "5"]) or |e| { panic(e.message()) }
    print(child.id() > 0)
    let mut result = child.try_wait() or |e| { panic(e.message()) }
    while result == none {
        result = child.try_wait() or |e| { panic(e.message()) }
    }
    if let some(o) = result {
        print(o.status)
    }
    // Asking again gives the same answer.
    let again = child.try_wait() or |e| { none }
    if let some(o) = again {
        print(o.status)
    }
    let joined = child.join() or |e| { panic(e.message()) }
    print(joined.status)

    // A program that reads its input: `findstr` copies the lines that match `.`.
    let mut o = process.options()
    o.input = some("one\r\ntwo\r\n")
    let echo = process.spawn_with("findstr", ["."], o) or |e| { panic(e.message()) }
    let copied = echo.join() or |e| { panic(e.message()) }
    print(copied.stdout.trim().replace("\r\n", "|"))

    // Killing a long-running program (about thirty seconds of pings).
    let slow = process.spawn("ping", ["-n", "30", "127.0.0.1"]) or |e| { panic(e.message()) }
    print(slow.try_wait() or |e| { none })
    let killed = slow.kill() or |e| { panic(e.message()) }
    print(killed.status != 0)
    match process.spawn("colibri-no-such-program", []) {
        ok(_)  => print("ran?")
        err(e) => print(e.message())
    }
}

// expect: true
// expect: 5
// expect: 5
// expect: 5
// expect: one|two
// expect: none
// expect: true
// expect: cannot run `colibri-no-such-program`: no such file or directory
