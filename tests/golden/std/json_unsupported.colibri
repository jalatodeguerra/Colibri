import json

enum Shape {
    Circle(float)
    Square(float)
}

enum Plain { A, B }

class Player { name: str }

struct HasShape { shape: Shape }

struct Pair[T] { a: T, b: T }

fn show[T: Show](r: Result[T]) {
    match r {
        ok(v)  => print("ok {v}")
        err(e) => print(e.message())
    }
}

fn main() {
    // Enums with data, classes and generic structs are errors with a reason, not wrong output.
    show(json.encode(Shape.Circle(1.0)))
    show(json.encode(HasShape { shape: .Square(2.0) }))
    show(json.decode[Shape](r"""{"Circle": 1.0}"""))
    show(json.decode[Shape](r"""{"Circle": 1.0}"""))
    show(json.encode(Player { name: "x" }))
    show(json.decode[Player](r"""{"name": "x"}"""))
    show(json.decode[Pair[int]](r"""{"a": 1, "b": 2}"""))
    // A map needs str keys to be an object.
    show(json.encode({1: "a"}))
    // JSON has no nan or infinity.
    show(json.encode(0.0 / 0.0))
    show(json.encode(1.0 / 0.0))
    let f = fn(x: int) => x
    show(json.encode(f))
    show(json.decode[fn(int) -> int]("1"))
    show(json.encode(Plain.B))
}

// expect: json: cannot encode the enum `Shape`: only enums whose variants carry no data are supported
// expect: json: cannot encode the enum `Shape`: only enums whose variants carry no data are supported
// expect: json: at `$`: cannot decode the enum `Shape`: only enums whose variants carry no data are supported
// expect: json: at `$`: cannot decode the enum `Shape`: only enums whose variants carry no data are supported
// expect: json: cannot encode a class object, function or host object
// expect: json: at `$`: `Player` is a class, and json works on structs and enums
// expect: json: at `$`: cannot decode the generic type `Pair[int]`
// expect: json: a Map becomes an object, so its keys must be str
// expect: json: cannot encode NaN: JSON has no such number
// expect: json: cannot encode inf: JSON has no such number
// expect: json: cannot encode a class object, function or host object
// expect: json: at `$`: cannot decode a value of the type `a function`
// expect: ok "B"
