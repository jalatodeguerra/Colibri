// caps: net
// What goes wrong on the way to a connection, as `net.Error` variants.
import net

fn kind[T](r: Result[T]) -> str {
    match r {
        ok(_) => return "ok"
        err(e) => return "{e.as[net.Error]().expect("a net error")}"
    }
}

fn main() -> Result[()] {
    // Refused: a port that was bound a moment ago and is closed now.
    let l = net.listen("127.0.0.1:0")?
    let addr = l.addr()
    l.close()
    let refused = net.connect(addr)
    print(kind(refused))
    print(refused.err().expect("refused").message().replace(addr, "<addr>"))

    // In use: a second listener on the port of the first.
    let first = net.listen("127.0.0.1:0")?
    let taken = net.listen(first.addr())
    print(kind(taken))
    print(taken.err().expect("in use").message().replace(first.addr(), "<addr>"))
    first.close()

    // Not an address.
    for text in ["", "localhost", "127.0.0.1", ":80", "::1:80", "[::1:80", "a b:80", "127.0.0.1:99999", "127.0.0.1:http"] {
        print("{kind(net.listen(text))} {kind(net.connect(text))}")
    }
    print(net.connect("localhost").err().expect("invalid").message())
    print(net.listen("[::1:80").err().expect("invalid").message())
    print(net.listen(":8080").err().expect("invalid").message())

    // A name that does not resolve (`.invalid` never does).
    print(kind(net.connect("no-such-host.invalid:80")))
    print(kind(net.listen("no-such-host.invalid:80")))
    // The text is Colibri's own and the same everywhere: the system's resolver words differ
    // between systems and are translated on Windows, so they are not shown.
    print(net.connect("no-such-host.invalid:80").err().expect("dns").message())
    print(net.listen("no-such-host.invalid:80").err().expect("dns").message())

    // An address that is not one of this machine's.
    print(kind(net.listen("203.0.113.1:0")))
    return ok(())
}

// expect: Refused
// expect: cannot connect to `<addr>`: connection refused (nothing is listening there)
// expect: AddrInUse
// expect: cannot listen on `<addr>`: address already in use (another socket has that port: stop it, or listen on port 0 for a free one)
// expect: InvalidAddress InvalidAddress
// expect: InvalidAddress InvalidAddress
// expect: InvalidAddress InvalidAddress
// expect: InvalidAddress InvalidAddress
// expect: InvalidAddress InvalidAddress
// expect: InvalidAddress InvalidAddress
// expect: InvalidAddress InvalidAddress
// expect: InvalidAddress InvalidAddress
// expect: InvalidAddress InvalidAddress
// expect: `localhost` is not an address: it needs a port (write `host:port`, like `127.0.0.1:8080` or `[::1]:8080`)
// expect: `[::1:80` is not an address: an IPv6 host in brackets must end with `]` before the port
// expect: `:8080` is not an address: the host is missing (write `127.0.0.1:8080` for this machine only, `0.0.0.0:8080` for every interface)
// expect: Dns
// expect: Dns
// expect: cannot find the address of `no-such-host.invalid` (check the spelling, or use an IP address)
// expect: cannot find the address of `no-such-host.invalid` (check the spelling, or use an IP address)
// expect: AddrNotAvailable
