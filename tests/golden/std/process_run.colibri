// caps: os
// only: unix - runs `sh`, `printf` and `tr` and uses `$VAR` and `$((..))` syntax; see process_windows.colibri
// Subprocesses through `sh`. The errors that do not depend on a shell are in process_errors.colibri.
import process
import os

fn main() {
    let r = process.run("sh", ["-c", "echo hello; echo oops >&2; exit 3"]) or |e| { panic(e.message()) }
    print(r.status)
    print(r.stdout)
    print(r.stderr)
    print(r)

    // A program that exits non-zero is not an error (one that fails to run is: see
    // process_errors.colibri).
    print(process.status("sh", ["-c", "exit 7"]) or |e| { -1 })
    print(process.output("sh", ["-c", "printf abc"]) or |e| { "failed" })
    match process.output("sh", ["-c", "echo bad >&2; exit 2"]) {
        ok(text) => print(text)
        err(e)   => print(e.message())
    }
    print(process.shell("echo $((6 * 7)) | tr 4 X") or |e| { panic(e.message()) })

    // Arguments are passed as they are, with no shell in between.
    let a = process.run("printf", ["%s|", "a b", "$HOME", ""]) or |e| { panic(e.message()) }
    print(a.stdout)

    // Options: folder, environment, standard input.
    let mut o = process.options()
    o.cwd = some("/")
    o.env = { "GREETING": "hi" }
    o.input = some("typed\n")
    let b = process.run_with("sh", ["-c", "pwd; echo $GREETING; cat"], o) or |e| { panic(e.message()) }
    print(b.stdout)

    // `os.set_env` is seen by the programs that follow.
    os.set_env("COLIBRI_CHILD", "yes")
    let c = process.shell("echo $COLIBRI_CHILD") or |e| { panic(e.message()) }
    print(c.stdout)
}

// expect: 3
// expect: hello
// expect:
// expect: oops
// expect:
// expect: Output { status: 3, stdout: "hello\n", stderr: "oops\n" }
// expect: 7
// expect: abc
// expect: `sh` failed with status 2: bad
// expect: Output { status: 0, stdout: "X2\n", stderr: "" }
// expect: a b|$HOME||
// expect: /
// expect: hi
// expect: typed
// expect:
// expect: yes
// expect:
