// caps: os
// A program's own `Output` and `DateTime` are not the library's.
import process
import datetime
import os

struct Output { text: str }
struct DateTime { label: str }

fn main() {
    let mine = Output { text: "mine" }
    // A program every system has: `sh` where there is one, `cmd` on Windows.
    let windows = os.platform() == "windows"
    let program = if windows { "cmd" } else { "sh" }
    let args = if windows { ["/C", "echo", "lib"] } else { ["-c", "printf lib"] }
    let theirs = process.run(program, args) or |e| { panic(e.message()) }
    print(mine.text)
    print(theirs.stdout.trim())
    let d = DateTime { label: "d" }
    print(d.label)
    print(datetime.from_unix(0.0).year)
}

// expect: mine
// expect: lib
// expect: d
// expect: 1970
