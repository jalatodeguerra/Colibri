// only: windows - runs `cmd`; process_error_failed.colibri is the Unix counterpart
// caps: os
// A non-zero status is data for `run`, and a `Failed` error for `output`. The text a program
// writes keeps its own line ends (`cmd` writes `\r\n`), so the message is trimmed.
import process

fn kind(e: Error) -> str {
    match e.as[process.Error]() {
        some(k) => return "{k}"
        none => return "not a process.Error"
    }
}

fn main() {
    print(process.run("cmd", ["/C", "exit", "3"]).expect("runs").status)
    let failed = process.output("cmd", ["/C", "echo", "oops", "1>&2", "&", "exit", "3"]).err().expect("fails")
    print(kind(failed))
    print(failed.message().trim())
}

// expect: 3
// expect: Failed
// expect: `cmd` failed with status 3: oops
