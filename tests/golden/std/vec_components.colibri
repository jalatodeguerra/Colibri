import vec

class Player {
    pos: vec.vec2
    vel: vec.vec2
}

struct Tile {
    cell: vec.ivec2
}

fn main() {
    let mut v = vec.vec3(1, 2, 3)
    print(v.x + v.y + v.z)
    v.y = 20
    v.z -= 1
    v.x *= 4
    print(v)

    let player = Player { pos: vec.vec2(0, 0), vel: vec.vec2(1, 2) }
    player.pos.x += 1.5
    player.pos += player.vel * 2
    print(player.pos)

    let tiles = [Tile { cell: vec.ivec2(1, 1) }, Tile { cell: vec.ivec2(2, 2) }]
    tiles[1].cell.y = 9
    tiles[0].cell += vec.ivec2(10, 10)
    print(tiles[0].cell)
    print(tiles[1].cell)

    let grid: Map[vec.ivec2, str] = {:}
    grid[vec.ivec2(1, 2)] = "a"
    print(grid[vec.ivec2(1, 2)])
    print(vec.ivec2(1, 2) == vec.ivec2(1, 2))
}
// expect: 6.0
// expect: vec3(4.0, 20.0, 2.0)
// expect: vec2(3.5, 4.0)
// expect: ivec2(11, 11)
// expect: ivec2(2, 9)
// expect: a
// expect: true
