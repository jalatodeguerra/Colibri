// allow: unused
import vec

fn main() {
    let a = vec.vec2(1, 2)
    let b = vec.vec3(1, 2, 3)
    let i = vec.ivec2(1, 2)
    print(a + b) // error: cannot apply `+` to `vec2` and `vec3`
    print(a + i) // error: cannot apply `+` to `vec2` and `ivec2`
    print(a.cross(a)) // error: `vec2` has no method `cross`
    print(a.foo()) // error: `vec2` has no method `foo`
    print(a.z) // error: the struct `vec2` has no field `z`
    print(a.q) // error: `vec2` has no field `q`
    print(b.w) // error: the struct `vec3` has no field `w`
    print(b.xq) // error: `vec3` has no field `xq`
    print(a.xxxxx) // error: has no field `xxxxx`
    print(a + 1) // error: cannot apply `+` to `vec2` and `{integer}`
    print(a - 1.5) // error: cannot apply `-` to `vec2` and `{float}`
    print(1 / a) // error: cannot apply `/` to `{integer}` and `vec2`
    print(a % a) // error: `%` cannot be applied to values of type `vec2`
    print(i * 1.5) // error: cannot apply `*` to `ivec2` and `{float}`
    let n = 3
    print(a * n) // error: cannot apply `*` to `vec2` and `int`
    print(vec.vec2(1, 2, 3)) // error: takes 2 arguments
    print(vec.vec2(1, "x")) // error: expected `float`, found `str`
    print(i.to_vec().foo()) // error: `vec2` has no method `foo`
    print(a.to_ivec().normalize()) // error: `ivec2` has no method `normalize`
    var m = a
    m.xy = a // error: the struct `vec2` has no field `xy`
    let k = vec.vec2(0, 0)
    k.x = 1 // error: cannot assign
    let r: vec.vec3 = a // error: expected `vec3`, found `vec2`
    let s: vec.vec2 = vec.vec2(0, 0).x // error: expected `vec2`, found `f32`
}
