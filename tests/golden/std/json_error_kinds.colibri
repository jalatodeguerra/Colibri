import json

struct Point {
    x: int
    y: int
}
class Handle {
    n: int
}

fn kind(e: Error) -> str {
    match e.as[json.Error]() {
        some(k) => return "{k}"
        none => return "not a json.Error"
    }
}

fn main() {
    print(kind(json.decode[Point]("{{\"x\": 1,").err().expect("syntax")))
    print(kind(json.decode[Point]("{{\"x\": 1}}").err().expect("missing field")))
    print(kind(json.decode[Point]("[1, 2]").err().expect("wrong shape")))
    print(kind(json.decode[i8]("300").err().expect("range")))
    print(kind(json.decode[Handle]("{{}}").err().expect("class")))
    print(kind(json.encode(0.0 / 0.0).err().expect("nan")))
    let e = json.decode[Point]("{{\"x\": 1}}").context("reading a point").err().expect("fails")
    print(e.is[json.Error]())
    print("{e}")
    print(kind(error("plain")))
}

// expect: Syntax
// expect: Mismatch
// expect: Mismatch
// expect: Mismatch
// expect: Unsupported
// expect: Unsupported
// expect: true
// expect: reading a point: json: at `$`: the object has no field `y` (a `Point` needs it)
// expect: not a json.Error
