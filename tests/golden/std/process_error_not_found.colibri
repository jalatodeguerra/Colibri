// caps: os
// A program that cannot be started is a `process.Error`; one that fails is still `Output` data
// (except for `process.output`).
import process

fn kind(e: Error) -> str {
    match e.as[process.Error]() {
        some(k) => return "{k}"
        none => return "not a process.Error"
    }
}

fn start(program: str) -> Result[str] {
    let out = process.run(program, []).context("starting {program}")?
    return ok(out.stdout)
}

fn main() {
    match start("colibri-no-such-program-xyz") {
        ok(_) => print("started")
        err(e) if e.is[process.Error]() => match e.as[process.Error]().expect("checked") {
            NotFound => print("missing program: {e}")
            _ => print("other: {e}")
        }
        err(e) => print("not a process error: {e}")
    }
    print(kind(process.spawn("colibri-no-such-program-xyz", []).err().expect("missing")))
    var o = process.options()
    o.cwd = some("/colibri/no/such/folder")
    print(kind(process.run_with("sh", ["-c", "true"], o).err().expect("no folder")))
    // A working folder that is missing, or is not a folder, is not "program not found".
    print(process.run_with("sh", ["-c", "true"], o).err().expect("no folder").message())
    o.cwd = some("/dev/null")
    let file = process.run_with("sh", ["-c", "true"], o).err().expect("a file")
    print(kind(file))
    print(file.message())
    print(kind(process.spawn_with("sh", ["-c", "true"], o).err().expect("a file")))
    // A non-zero status is data for `run`, a `Failed` error for `output`.
    print(process.run("sh", ["-c", "exit 3"]).expect("runs").status)
    let failed = process.output("sh", ["-c", "echo oops >&2; exit 3"]).err().expect("fails")
    print(kind(failed))
    print(failed.message())
    print(kind(error("plain")))
}

// expect: missing program: starting colibri-no-such-program-xyz: cannot run `colibri-no-such-program-xyz`: no such file or directory
// expect: NotFound
// expect: InvalidDirectory
// expect: cannot run `sh`: the folder `/colibri/no/such/folder` does not exist
// expect: InvalidDirectory
// expect: cannot run `sh`: the folder `/dev/null` is not a directory
// expect: InvalidDirectory
// expect: 3
// expect: Failed
// expect: `sh` failed with status 3: oops
// expect: not a process.Error
