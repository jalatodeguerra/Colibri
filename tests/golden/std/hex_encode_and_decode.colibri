import hex

fn main() {
    print(hex.encode("Hi!".to_bytes()))
    print(hex.encode(Bytes()))
    print(hex.encode(Bytes([0, 15, 16, 255])))
    print(hex.decode("486921"))
    print(hex.decode("486F"))
    print(hex.decode("000F10ff"))
    print(hex.decode(""))
    print(hex.decode("486921").expect("valid").to_str())
    for bad in ["abc", "zz", "0x10"] {
        match hex.decode(bad) {
            ok(_) => print("decoded?")
            err(e) => print(e.message())
        }
    }
    match hex.decode("zz") {
        ok(_) => print("decoded?")
        err(e) => print(e.as[hex.Error]() == some(hex.Error.Invalid))
    }
}

// expect: 486921
// expect: 
// expect: 000f10ff
// expect: ok(b"Hi!")
// expect: ok(b"Ho")
// expect: ok(b"\x00\x0f\x10\xff")
// expect: ok(b"")
// expect: ok("Hi!")
// expect: hex: the length 3 is odd, two digits make a byte
// expect: hex: `z` at position 0 is not a hex digit
// expect: hex: `x` at position 1 is not a hex digit
// expect: true
