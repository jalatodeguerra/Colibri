import math

fn main() {
    print(math.floor(-1.5))
    print(math.ceil(-1.5))
    print(math.round(2.5))
    print(math.round(-2.5))
    print(math.trunc(-1.9))
    print(math.fract(2.75))
    print(math.signf(-3.0))
    print(math.signf(0.0))
    print(math.clampf(5.5, 0.0, 1.0))
    print(math.lerp(10.0, 20.0, 0.25))
    print(math.degrees(math.PI))
    print(math.radians(180.0) == math.PI)
    print(math.is_nan(math.sqrt(-1.0)))
    print(math.is_finite(1.0 / 0.0))
    print(math.sqrt(-1.0))
}

// expect: -2.0
// expect: -1.0
// expect: 3.0
// expect: -3.0
// expect: -1.0
// expect: 0.75
// expect: -1.0
// expect: 0.0
// expect: 1.0
// expect: 12.5
// expect: 180.0
// expect: true
// expect: true
// expect: false
// expect: nan
