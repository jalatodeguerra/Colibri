import vec
import vec.{vec2, ivec2}

// `vec` is written in Colibri, so everything a program can do with its own structs works on its
// types: implement an interface for them, use them in generic code, key a map by them.
interface Describe {
    fn describe(self) -> str
}

impl Describe for vec.vec2 {
    fn describe(self) -> str => "a vec2 of length {self.len()}"
}

impl Describe for ivec2 {
    fn describe(self) -> str => "a cell at {self.x}, {self.y}"
}

fn tell[T: Describe](x: T) -> str => x.describe()

// operators in generic code reach the library's impls
fn sum[T: Add](xs: List[T], zero: T) -> T {
    let mut acc = zero
    for x in xs {
        acc += x
    }
    return acc
}

fn flip[T: Neg](x: T) -> T => -x

// the program can add an operator to the library's types when the right-hand type is its own
// (a library type on the right would let the library add the same impl later)
struct Offset { k: float }
impl Sub[Offset] for vec2 {
    fn sub(self, o: Offset) -> vec2 => self - vec2(o.k, o.k)
}

fn main() {
    print(tell(vec2(3, 4)))
    print(tell(ivec2(1, 2)))
    print(sum([vec2(1, 2), vec2(3, 4), vec2(5, 6)], vec2(0, 0)))
    print(sum([ivec2(1, 2), ivec2(3, 4)], ivec2(0, 0)))
    print(flip(vec2(1, -2)))
    print(flip(ivec2(1, -2)))
    print(vec2(5, 5) - Offset { k: 1.5 })
    let seen: Map[ivec2, int] = {:}
    seen[ivec2(1, 1)] = 7
    seen[ivec2(1, 1)] += 1
    print(seen[ivec2(1, 1)])
    // a list of vectors, sorted by hand through a key
    let pts = [vec2(3, 1), vec2(1, 2), vec2(2, 0)]
    let mut best = pts[0]
    for p in pts {
        if p.x < best.x {
            best = p
        }
    }
    print(best)
    // equality is structural
    print(vec2(1, 2) == vec2(1, 2))
    print(ivec2(1, 2) == ivec2(2, 1))
    // `f32` on the right of `*` widens like any scalar
    let dt: f32 = 0.5
    print(vec2(2, 4) * dt)
    print(dt * vec2(2, 4))
}
// expect: a vec2 of length 5.0
// expect: a cell at 1, 2
// expect: vec2(9.0, 12.0)
// expect: ivec2(4, 6)
// expect: vec2(-1.0, 2.0)
// expect: ivec2(-1, 2)
// expect: vec2(3.5, 3.5)
// expect: 8
// expect: vec2(1.0, 2.0)
// expect: true
// expect: false
// expect: vec2(1.0, 2.0)
// expect: vec2(1.0, 2.0)
