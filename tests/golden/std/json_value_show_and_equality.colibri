import json

fn parse(text: str) -> json.Value => json.parse(text).expect("parses")

fn main() {
    let a = parse(r"""{"x": [1, 2.5, "s", null, true], "y": {"p": 1, "q": 2}}""")
    let b = parse(r"""{"y": {"q": 2, "p": 1}, "x": [1, 2.5, "s", null, true]}""")
    let c = parse("[1]")
    // Show is the compact JSON text, also nested.
    print(a)
    print("{c} {[c, c]} {some(c)}")
    // `==` is structural, with the rules of `equals`.
    print(a == b)
    print(a != c)
    print(a == b && a.equals(b))
    print(parse("1") == parse("1.0"))
    print(json.Value.float(0.0 / 0.0) == json.Value.float(0.0 / 0.0))
    // A key or element is found by structure.
    let m: Map[json.Value, int] = {c: 1}
    m[parse("[1]")] = 2
    print(m.len())
    print(m[c])
    print(Set([a, b, c]).len())
}

// expect: {"x":[1,2.5,"s",null,true],"y":{"p":1,"q":2}}
// expect: [1] [[1], [1]] some([1])
// expect: true
// expect: true
// expect: true
// expect: false
// expect: true
// expect: 1
// expect: 2
// expect: 2
