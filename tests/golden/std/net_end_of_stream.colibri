// caps: net
// How a script tells the end of the stream. `read(n)` with `n` of 1 or more gives empty bytes
// only at the end (it waits until at least one byte is there); `read(0)` gives empty bytes
// whatever the state (it asks for nothing, so it never waits and says nothing about the end).
// `read_line` gives `none` at the end, `read_exact` gives `UnexpectedEnd`.
import net

fn serve(l: net.Listener) -> Result[()] {
    let c = l.accept()?
    c.write("ab\ncd")?
    c.close()
    return ok(())
}

fn main() -> Result[()] {
    let l = net.listen("127.0.0.1:0")?
    let server = go serve(l)
    let c = net.connect(l.addr())?
    // Not at the end: `read(0)` is empty all the same, and takes nothing.
    print(c.read(0)?.len())
    print(c.read_line()?)
    // Read what is left, one byte at a time, until `read(1)` is empty: that is the end.
    var rest = 0
    while true {
        let one = c.read(1)?
        if one.len() == 0 {
            break
        }
        rest += one.len()
    }
    print("{rest} bytes were left")
    // At the end every kind of read says so, and keeps saying so.
    print(c.read(1)?.len())
    print(c.read(0)?.len())
    print(c.read_line()?)
    print(c.read_exact(1).is_err())
    server.join()?
    return ok(())
}

// expect: 0
// expect: some("ab")
// expect: 2 bytes were left
// expect: 0
// expect: 0
// expect: none
// expect: true
