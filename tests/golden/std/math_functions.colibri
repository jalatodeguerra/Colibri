// The functions that are not exact IEEE operations come from `libm`, so these digits are the
// same on every platform. They are libm's, within an ulp of the true value: `exp(1.0)` is
// not exactly `math.E`.
import math

fn main() {
    print(math.sin(0.0))
    print(math.sin(1.0))
    print(math.cos(1.0))
    print(math.tan(1.0))
    print(math.asin(1.0))
    print(math.acos(0.0))
    print(math.atan(1.0))
    print(math.atan2(1.0, 1.0))
    print(math.sinh(1.0))
    print(math.exp(1.0))
    print(math.exp2(10.0))
    print(math.ln(10.0))
    print(math.log2(8.0))
    print(math.log10(1000.0))
    print(math.log(100.0, 10.0))
    print(math.pow(2.0, 10.0))
    print(math.pow(2.0, 0.5))
    print(math.sqrt(2.0))
    print(math.cbrt(27.0))
    print(math.hypot(3.0, 4.0))
}

// expect: 0.0
// expect: 0.8414709848078965
// expect: 0.5403023058681398
// expect: 1.5574077246549023
// expect: 1.5707963267948966
// expect: 1.5707963267948966
// expect: 0.7853981633974483
// expect: 0.7853981633974483
// expect: 1.1752011936438014
// expect: 2.7182818284590455
// expect: 1024.0
// expect: 2.302585092994046
// expect: 3.0
// expect: 3.0
// expect: 2.0
