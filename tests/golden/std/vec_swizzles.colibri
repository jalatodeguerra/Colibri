import vec

fn main() {
    let v = vec.vec4(1, 2, 3, 4)
    print(v.xy)
    print(v.zyx)
    print(v.xxyy)
    print(v.wzyx)
    print(v.xyz.zy)
    let i = vec.ivec3(5, 6, 7)
    print(i.zx)
    print(i.xxx)
    print(vec.vec2(1, 2).yxyx)
    var p = vec.vec2(1, 2)
    p.x = p.yx.x * 10
    print(p)
}
// expect: vec2(1.0, 2.0)
// expect: vec3(3.0, 2.0, 1.0)
// expect: vec4(1.0, 1.0, 2.0, 2.0)
// expect: vec4(4.0, 3.0, 2.0, 1.0)
// expect: vec2(3.0, 2.0)
// expect: ivec2(7, 5)
// expect: ivec3(5, 5, 5)
// expect: vec4(2.0, 1.0, 2.0, 1.0)
// expect: vec2(20.0, 2.0)
