import base64

fn main() {
    for text in ["Zm9", "Zm9v!A==", "Zh==", "Zg=", "A"] {
        match base64.decode(text) {
            ok(_) => print("decoded?")
            err(e) => print(e.message())
        }
    }
    // Bytes that are not text.
    match base64.decode("/w==") {
        ok(_) => print("decoded?")
        err(e) => {
            print(e.as[base64.Error]() == some(base64.Error.NotText))
            print(e.message())
        }
    }
    match base64.decode("Zg") {
        ok(_) => print("decoded?")
        err(e) => print(e.as[base64.Error]() == some(base64.Error.Invalid))
    }
    // A byte outside 0..=255.
    match base64.encode_bytes([1, 256]) {
        ok(_) => print("encoded?")
        err(e) => {
            print(e.as[base64.Error]() == some(base64.Error.OutOfRange))
            print(e.message())
        }
    }
    match base64.decode_url("Zg==") {
        ok(_) => print("decoded?")
        err(e) => print(e.message())
    }
}

// expect: base64: the length 3 is not a multiple of 4 (is the `=` padding missing?)
// expect: base64: `!` at position 4 is not in the alphabet
// expect: base64: the last character has stray bits set
// expect: base64: the length 3 is not a multiple of 4 (is the `=` padding missing?)
// expect: base64: the length 1 is not a multiple of 4 (is the `=` padding missing?)
// expect: true
// expect: base64: the decoded bytes are not UTF-8 text (invalid utf-8 sequence of 1 bytes from index 0); use decode_bytes
// expect: true
// expect: true
// expect: base64: a byte must be between 0 and 255, but item 1 of the list is 256
// expect: base64: the URL form has no `=` padding
