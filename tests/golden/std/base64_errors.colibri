import base64

fn main() {
    for text in ["Zm9", "Zm9v!A==", "Zh==", "Zg=", "A"] {
        match base64.decode(text) {
            ok(_) => print("decoded?")
            err(e) => print(e.message())
        }
    }
    match base64.decode("Zg") {
        ok(_) => print("decoded?")
        err(e) => print(e.as[base64.Error]() == some(base64.Error.Invalid))
    }
    match base64.decode_url("Zg==") {
        ok(_) => print("decoded?")
        err(e) => print(e.message())
    }
    // Bytes that are not text decode fine; turning them into a `str` is a separate step.
    match base64.decode("/w==") {
        ok(b) => {
            print(b)
            print(b.to_str().is_err())
        }
        err(e) => print(e.message())
    }
}

// expect: base64: the length 3 is not a multiple of 4 (is the `=` padding missing?)
// expect: base64: `!` at position 4 is not in the alphabet
// expect: base64: the last character has stray bits set
// expect: base64: the length 3 is not a multiple of 4 (is the `=` padding missing?)
// expect: base64: the length 1 is not a multiple of 4 (is the `=` padding missing?)
// expect: true
// expect: base64: the URL form has no `=` padding
// expect: b"\xff"
// expect: true
