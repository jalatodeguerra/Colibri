import datetime

fn main() {
    let t = datetime.new(2024, 2, 28, 23, 30, 0) or |e| { panic(e.message()) }
    print(datetime.to_iso(datetime.add(t, 1800.0)))
    print(datetime.to_iso(datetime.add(t, datetime.DAY)))
    print(datetime.to_iso(datetime.add(t, 2.0 * datetime.DAY)))
    print(datetime.to_iso(datetime.add(t, -datetime.WEEK)))
    print(datetime.to_iso(datetime.add(t, 0.5)))
    let later = datetime.add(t, 3 * 3600.0 + 15.0)
    print(datetime.diff(later, t))
    print(datetime.diff(t, later))
    // The same instant at another offset is a different struct but zero apart.
    let shifted = datetime.with_offset(t, 3600)
    print(shifted == t)
    print(datetime.diff(shifted, t))
    print(shifted.hour)
    // `add` keeps the offset it was given.
    print(datetime.to_iso(datetime.add(shifted, datetime.HOUR)))
    print(datetime.to_unix(t))
    print(datetime.from_unix(datetime.to_unix(t)) == t)
}

// expect: 2024-02-29T00:00:00Z
// expect: 2024-02-29T23:30:00Z
// expect: 2024-03-01T23:30:00Z
// expect: 2024-02-21T23:30:00Z
// expect: 2024-02-28T23:30:00.5Z
// expect: 10815.0
// expect: -10815.0
// expect: false
// expect: 0.0
// expect: 0
// expect: 2024-02-29T01:30:00+01:00
// expect: 1709163000.0
// expect: true
