// expect: ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad
// expect: 248d6a61d20638b8e5c026930c3e6039a33ce45964ff2167f6ecedd419db06c1
// expect: 3c48591d8d098a4538f5e013dfcf406e948eac4d3277b10bf614e295d6068179
// expect: ok("ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad")
// expect: ok("e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855")
// expect: true
// expect: hash: a byte must be between 0 and 255, but item 0 of the list is 300
