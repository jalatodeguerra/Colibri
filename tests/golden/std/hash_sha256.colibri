import hash

fn main() {
    print(hash.sha256_hex("".to_bytes()))
    print(hash.sha256_hex("abc".to_bytes()))
    print(hash.sha256_hex("abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq".to_bytes()))
    print(hash.sha256_hex("héllo".to_bytes()))
    print(hash.sha256_hex(Bytes([97, 98, 99])))
    // The digest itself is 32 bytes.
    let digest = hash.sha256("abc".to_bytes())
    print(digest.len())
    print(digest[0])
    print(digest[31])
    print(digest[0..4])
    // Binary input is hashed as it is.
    print(hash.sha256_hex(Bytes([0, 255, 128])))
}

