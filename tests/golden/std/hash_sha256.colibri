import hash

fn main() {
    print(hash.sha256(""))
    print(hash.sha256("abc"))
    print(hash.sha256("abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq"))
    print(hash.sha256("héllo"))
    print(hash.sha256_bytes([97, 98, 99]))
    print(hash.sha256_bytes([]))
    match hash.sha256_bytes([300]) {
        ok(_) => print("hashed?")
        err(e) => {
            print(e.as[hash.Error]() == some(hash.Error.OutOfRange))
            print(e.message())
        }
    }
}

