// DESIGN §2 without `vec2`, imports and `Result`.
struct Player {
    name: str
    pos: int
    hp: int = 100
}

enum Command {
    Move(int)
    Heal(int)
    Quit
}

fn greet(name: str) -> str => "Hello, {name}!"

fn apply(p: Player, cmd: Command) -> Player {
    let mut next = p                       // structs are values: this is a copy
    match cmd {
        Move(dir) => next.pos += dir
        Heal(n)   => next.hp = if next.hp + n > 100 { 100 } else { next.hp + n }
        Quit      => {}
    }
    return next
}

fn main() {
    print(greet("Ana"))
    let mut hero = Player { name: "Ana", pos: 0, hp: 60 }
    let before = hero
    hero = apply(hero, .Move(1))     // `.Move`: the expected type is Command
    hero = apply(hero, .Heal(70))
    hero = apply(hero, .Quit)
    print("{hero.name} is at {hero.pos} with {hero.hp} hp")
    print(before)
}

// expect: Hello, Ana!
// expect: Ana is at 1 with 100 hp
// expect: Player { name: "Ana", pos: 0, hp: 60 }
