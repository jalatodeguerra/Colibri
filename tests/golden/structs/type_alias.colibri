struct Point { x: int, y: int }
type Pos = Point
type Score = int

fn origin() -> Pos {
    return Point { x: 0, y: 0 }
}

fn best(a: Score, b: Score) -> Score {
    if a > b { return a }
    return b
}

fn main() {
    let p: Pos = origin()
    let q: Point = p
    print(q == p)
    print(best(3, 8))
    let mut s: Score = 1
    s += best(2, 5)
    print(s)
}

// expect: true
// expect: 8
// expect: 6
