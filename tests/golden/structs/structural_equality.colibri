struct P { x: int, y: int }
struct Line { a: P, b: P }

fn main() {
    let p = P { x: 1, y: 2 }
    print(p == P { x: 1, y: 2 })
    print(p == P { x: 1, y: 3 })
    print(p != P { x: 9, y: 9 })
    let l1 = Line { a: p, b: P { x: 0, y: 0 } }
    let l2 = Line { a: P { x: 1, y: 2 }, b: P { x: 0, y: 0 } }
    print(l1 == l2)
}

// expect: true
// expect: false
// expect: true
// expect: true
