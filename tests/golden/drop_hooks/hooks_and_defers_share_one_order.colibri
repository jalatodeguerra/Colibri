class Res { name: str }

impl Drop for Res {
    fn drop(self) { print("drop {self.name}") }
}

fn main() {
    let a = Res { name: "a" }
    defer print("deferred 1")
    let b = Res { name: "b" }
    defer print("deferred 2")
}

// expect: deferred 2
// expect: drop b
// expect: deferred 1
// expect: drop a
// drops: b, a
