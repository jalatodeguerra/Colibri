// allow: unused
class T { name: str }
impl Drop for T {
    fn drop(self) { print("drop {self.name}") }
}
class Bad { name: str }
impl Drop for Bad {
    fn drop(self) {
        print("bad hook {self.name}")
        let z = 0
        print(1 / z)
    }
}
fn mk(n: str) -> T => T { name: n }
fn n_of(s: str) -> int => 3
fn helper() {
    print("helper one")
    print("helper two")
}

fn main() {
    let a = mk("a")
    let mut i = 0
    while n_of(Bad { name: "w{i}" }.name) > i {
        print("body {i}")
        helper()
        i = i + 1
    }
    print("after")
}

// expect: bad hook w0
// expect: drop a
// panic: division by zero
// drops: w0, a
