// allow: unused
class Res { name: str }

impl Drop for Res {
    fn drop(self) { print("drop {self.name}") }
}

fn main() {
    let mut r = Res { name: "first" }
    r = Res { name: "second" }
    print("assigned")
}

// expect: drop first
// expect: assigned
// expect: drop second
// drops: first, second
