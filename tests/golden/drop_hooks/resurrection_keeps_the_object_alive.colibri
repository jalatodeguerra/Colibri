// allow: unused
class Res { name: str }

let mut saved: List[Res] = []

impl Drop for Res {
    fn drop(self) {
        print("hook {self.name}")
        saved.push(self)
    }
}

fn main() {
    {
        let r = Res { name: "phoenix" }
    }
    print("after scope: {saved.len()} saved")
    print(saved[0].name)
}

// expect: hook phoenix
// expect: after scope: 1 saved
// expect: phoenix
// drops: phoenix
