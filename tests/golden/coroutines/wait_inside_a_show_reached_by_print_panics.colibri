// `print` is native code: it calls the user's `show` with Rust frames underneath, so a coroutine
// cannot pause inside it.
struct Gate {
    n: int
}

impl Show for Gate {
    fn show(self) -> str {
        wait(1.0)
        return "gate {self.n}"
    }
}

fn worker() {
    print(Gate { n: 1 })
    print("not reached")
}

fn main() {
    go worker()
    task.tick(1.0)
    print("main goes on")
}

// panic: `wait` cannot pause inside code that a built-in operation calls (a `Show`, `Eq`, `Ord`, `Hash` or `Clone` impl, or an iterator's `next`)
