// A `show` the program calls itself is an ordinary call: the coroutine may pause inside it.
struct Gate {
    n: int
}

impl Show for Gate {
    fn show(self) -> str {
        wait(1.0)
        return "gate {self.n}"
    }
}

fn worker() {
    let g = Gate { n: 7 }
    let text = g.show()
    print(text)
}

fn main() {
    go worker()
    task.tick(0.5)
    print("tick 1")
    task.tick(1.0)
    print("tick 2")
}

// expect: tick 1
// expect: gate 7
// expect: tick 2
