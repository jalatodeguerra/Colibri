fn leaf(name: str) {
    print("{name} start")
    wait(1.0)
    print("{name} end")
}

fn middle() {
    go leaf("leaf1")
    wait(0.5)
    go leaf("leaf2")
    print("middle end")
}

fn main() {
    go middle()
    task.tick(0.5)
    print("t 0.5")
    task.tick(0.5)
    print("t 1.0")
    task.tick(0.5)
    print("t 1.5")
}

// expect: leaf1 start
// expect: leaf2 start
// expect: middle end
// expect: t 0.5
// expect: leaf1 end
// expect: t 1.0
// expect: leaf2 end
// expect: t 1.5
