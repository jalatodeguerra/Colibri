class Bad { name: str }

impl Drop for Bad {
    fn drop(self) {
        print("drop {self.name}")
        if self.name == "a" {
            let zero = 0
            print(1 / zero)
        }
    }
}

struct Pt {
    x: int
    tag: str
}

fn main() {
    let mut p = Pt { x: 1, tag: "t" }
    let mut xs = [Bad { name: "a" }, Bad { name: "b" }]
    for mut x in xs {
        let t = p.tag
        print(t)
        print("trip {x.name}")
        x = Bad { name: x.name + "2" }
    }
    print("after")
}

// expect: t
// expect: trip a
// expect: drop a
// expect: drop a2
// expect: drop b
// panic: division by zero
// drops: a, a2, b
