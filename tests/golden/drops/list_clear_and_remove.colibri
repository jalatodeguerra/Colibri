class T { name: str }

fn main() {
    let mut xs = [T { name: "a" }, T { name: "b" }, T { name: "c" }, T { name: "d" }]
    xs.remove(1)
    print("removed one")
    xs.pop()
    print("popped one")
    xs.clear()
    print("cleared")
}

// expect: removed one
// expect: popped one
// expect: cleared
// drops: b, d, a, c
