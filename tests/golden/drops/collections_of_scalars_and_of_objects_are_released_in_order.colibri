// A list, set or map of scalars and strings is freed whole; one that holds an object runs its
// hooks, in order, when the last reference goes.
class Res { name: str }
impl Drop for Res {
    fn drop(self) {
        print("drop {self.name}")
    }
}

fn scalars() {
    let a = [1, 2, 3]
    let b = {"x": 1, "y": 2}
    let mut c = Set[int]()
    c.add(4)
    c.add(5)
    let d = {1: "one", 2: "two"}
    let e = ["a", "b"]
    print("scalars {a.len() + b.len() + c.len() + d.len() + e.len()}")
}

fn objects() {
    let a = [Res { name: "l1" }, Res { name: "l2" }]
    let b = {1: Res { name: "m1" }, 2: Res { name: "m2" }}
    let c = {"k": [Res { name: "n1" }]}
    let mut s = Set[Res]()
    s.add(Res { name: "s1" })
    print("objects {a.len() + b.len() + c.len() + s.len()}")
}

fn shared() {
    let a = [1, 2, 3]
    let b = a
    print("shared {b.len()}")
}

fn main() {
    scalars()
    print("between")
    objects()
    print("between")
    shared()
    let mut m: Map[int, int] = {:}
    for i in 0..100 {
        m[i] = i
    }
    m = {:}
    print("end")
}

// expect: scalars 11
// expect: between
// expect: objects 6
// expect: drop s1
// expect: drop n1
// expect: drop m1
// expect: drop m2
// expect: drop l1
// expect: drop l2
// expect: between
// expect: shared 3
// expect: end
