class Bad { name: str }

impl Drop for Bad {
    fn drop(self) {
        print("drop {self.name}")
        if self.name == "a" {
            let zero = 0
            print(1 / zero)
        }
    }
}

class Holder {
    name: str
    n: int
}

fn main() {
    let h = Holder { name: "h", n: 0 }
    let xs = [Bad { name: "a" }, Bad { name: "b" }]
    for mut x in xs {
        h.name = "z"
        print("trip {x.name}")
        x = Bad { name: x.name + "2" }
    }
    print("after")
}

// expect: trip a
// expect: drop a
// expect: drop a2
// expect: drop b
// panic: division by zero
// drops: a, a2, b, z
