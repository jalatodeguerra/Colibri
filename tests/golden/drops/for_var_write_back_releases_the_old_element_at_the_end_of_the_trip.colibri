// allow: unused
class Res { name: str }
struct Slot { r: Res, n: int }

fn main() {
    var slots = [Slot { r: Res { name: "old0" }, n: 0 }, Slot { r: Res { name: "old1" }, n: 1 }]
    for var s in slots {
        let local = Res { name: "local{s.n}" }
        s.r = Res { name: "new{s.n}" }
        print("end of trip {s.n}")
        if s.n == 0 {
            continue
        }
        break
    }
    print("after the loop")
}

// expect: end of trip 0
// expect: end of trip 1
// expect: after the loop
// drops: local0, old0, local1, old1, new0, new1
