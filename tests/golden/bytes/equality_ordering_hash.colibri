fn main() {
    let a = Bytes([1, 2, 3])
    let b = Bytes([1, 2, 3])
    print(a == b)
    print(a != b)
    print(a == Bytes([1, 2]))
    print(Bytes([1, 2]) < a)
    print(Bytes([1, 3]) > a)
    print(Bytes([255]) > Bytes([1, 2, 3]))
    print(Bytes() <= Bytes())
    let m = Map[Bytes, str]()
    m.insert(a, "first")
    m.insert(b, "second")
    m.insert(Bytes(), "empty")
    print(m.len())
    print(m.get(Bytes([1, 2, 3])))
    let s = Set([a, b, Bytes([9])])
    print(s.len())
    print(s.contains(Bytes([9])))
    let sorted = [Bytes([2]), Bytes([1, 5]), Bytes([1])].sorted()
    print(sorted)
}

// expect: true
// expect: false
// expect: false
// expect: true
// expect: true
// expect: true
// expect: true
// expect: 2
// expect: some("second")
// expect: 2
// expect: true
// expect: [b"\x01", b"\x01\x05", b"\x02"]
