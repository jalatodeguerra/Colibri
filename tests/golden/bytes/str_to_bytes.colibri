fn main() {
    let s = "añb"
    let b = s.to_bytes()
    print(b)
    print(b.len() == s.len())
    print(b.to_str() == ok(s))
    let mut total = 0
    for x in s.bytes() {
        total += int(x)
    }
    let mut total2 = 0
    for x in b {
        total2 += int(x)
    }
    print(total == total2)
}

// expect: b"a\xc3\xb1b"
// expect: true
// expect: true
// expect: true
