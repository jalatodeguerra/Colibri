fn grade(score: int) -> str {
    if score >= 90 {
        return "A"
    } else if score >= 80 {
        return "B"
    } else if score >= 70 {
        return "C"
    } else {
        return "F"
    }
}
print(grade(95))
print(grade(85))
print(grade(75))
print(grade(10))
// expect: A
// expect: B
// expect: C
// expect: F
