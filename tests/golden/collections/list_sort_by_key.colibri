fn main() {
    var words = ["ccc", "a", "bb", "dd"]
    words.sort_by_key(fn(w) => w.len())
    print(words)
    words.sort_by_key(fn(w) => w)
    print(words)
    var pairs = [(2, "x"), (1, "y"), (2, "a")]
    pairs.sort_by_key(fn(p) => p.0)
    print(pairs)
}

// expect: ["a", "bb", "dd", "ccc"]
// expect: ["a", "bb", "ccc", "dd"]
// expect: [(1, "y"), (2, "x"), (2, "a")]
