enum Chain { Nil, Cons(int, Chain) }

fn build(n: int) -> Chain {
    let mut l = Chain.Nil
    let mut i = 0
    while i < n {
        l = .Cons(i, l)
        i += 1
    }
    return l
}

fn main() {
    // Keys a few hundred levels deep are ordinary keys.
    let s = Set([build(300), build(300)])
    print(s.len())
    print(s.contains(build(300)))
    let mut m = {build(300): 1}
    m[build(300)] = 2
    print(m.len())
    print(Set([build(300)]) == Set([build(300)]))
    // A key too deep to compare is a panic, never a wrong answer.
    let deep = Set([build(50000)])
    print(deep.contains(build(50000))) // panic: these values nest too deeply to compare
}
// expect: 1
// expect: true
// expect: 1
// expect: true
