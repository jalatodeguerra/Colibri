enum Chain { Nil, Cons(int, Chain) }
fn build(n: int) -> Chain {
    let mut l = Chain.Nil
    let mut i = 0
    while i < n {
        l = .Cons(i, l)
        i += 1
    }
    return l
}
fn main() {
    let m = {build(50000): 1, build(50000): 2}
    print(m.len())
}

