fn main() {
    let s = Set[int]()
    s.add(3)
    s.add(1)
    s.add(3)
    print(s)
    print(s.len())
    print(s.contains(1))
    print(s.contains(2))
    print(s.remove(1))
    print(s.remove(1))
    print(s)
    print(s.is_empty())
    s.clear()
    print(s)
    print(s.is_empty())
}

// expect: Set([3, 1])
// expect: 2
// expect: true
// expect: false
// expect: true
// expect: false
// expect: Set([3])
// expect: false
// expect: Set([])
// expect: true
