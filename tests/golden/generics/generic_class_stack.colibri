class Stack[T] {
    items: List[T] = []
}

impl[T] Stack[T] {
    fn push(self, x: T) { self.items.push(x) }
    fn pop(self) -> T? => self.items.pop()
    fn size(self) -> int => self.items.len()
}

fn main() {
    let s = Stack[int] { }
    s.push(1)
    s.push(2)
    print(s.size())
    print(s.pop())
    print(s.pop())
    print(s.pop())
    let names: Stack[str] = Stack { }
    names.push("a")
    print(names.items)
}

// expect: 2
// expect: some(2)
// expect: some(1)
// expect: none
// expect: ["a"]
