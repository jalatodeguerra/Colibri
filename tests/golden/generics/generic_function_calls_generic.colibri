fn twice[T](x: T) -> (T, T) => (x, x)

fn quad[T](x: T) -> ((T, T), (T, T)) {
    let t = twice(x)
    return twice(t)
}

fn largest[T: Ord](xs: List[T]) -> T? {
    if xs.is_empty() { return none }
    var best = xs[0]
    for x in xs {
        if x > best { best = x }
    }
    return some(best)
}

fn main() {
    print(quad(1))
    print(largest([3, 9, 2]))
    print(largest(["b", "a"]))
    let nothing: List[int] = []
    print(largest(nothing))
}

// expect: ((1, 1), (1, 1))
// expect: some(9)
// expect: some("b")
// expect: none
