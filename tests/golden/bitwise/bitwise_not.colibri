fn main() {
    let zero: int = 0
    print(~zero)
    let a: u8 = 0
    print(~a)
    let b: u8 = 0xF0
    print(~b)
    let c: i8 = 5
    print(~c)
    let d: i8 = 127
    print(~d)
    let e: u32 = 1
    print(~e)
    let f: u64 = 0
    print(~f)
    print(~~b == b)
    let g: i16 = -1
    print(~g)
}
// expect: -1
// expect: 255
// expect: 15
// expect: -6
// expect: -128
// expect: 4294967294
// expect: 18446744073709551615
// expect: true
// expect: 0
