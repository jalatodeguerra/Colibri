fn main() {
    print(1 << 10)
    print(1024 >> 3)
    print(0xFF >> 4)
    let a: u32 = 1
    print(a << 31)
    let b: u16 = 0xABCD
    print(b >> 8)
    print(b << 4)
    let c: int = 3
    print(c << 0)
    print(c >> 0)
}
// expect: 1024
// expect: 128
// expect: 15
// expect: 2147483648
// expect: 171
// expect: 48336
// expect: 3
// expect: 3
