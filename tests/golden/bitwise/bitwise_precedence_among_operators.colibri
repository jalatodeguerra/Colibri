fn main() {
    print(1 + 2 << 3)
    print(2 * 3 & 4)
    print(1 | 2 ^ 3 & 4)
    print(1 | 2 & 3)
    let x = 5
    print(x << 1 | 1)
    print(~1 + 1)
    print(-x & 7)
    print(x & 3 << 1)
    print(8 >> 1 >> 1)
}
// expect: 24
// expect: 4
// expect: 3
// expect: 3
// expect: 11
// expect: -1
// expect: 3
// expect: 4
// expect: 2
