fn main() {
    let a: i8 = 64
    print(a << 1)
    let b: i8 = 1
    print(b << 7)
    let c: i8 = 3
    print(c << 6)
    print(1 << 62)
    print(1 << 63)
    let d: i32 = 1
    print(d << 31)
}
// expect: -128
// expect: -128
// expect: -64
