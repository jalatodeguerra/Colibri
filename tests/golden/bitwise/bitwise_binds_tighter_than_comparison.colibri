fn main() {
    let x = 6
    print(x & 1 == 0)
    print(x & 1 != 0)
    print(x | 1 == 7)
    print(x ^ 2 == 4)
    print(x >> 1 == 3)
    print(x << 1 > 10)
    print(x & 4 == 4 && x & 1 == 0)
}
// expect: true
// expect: false
// expect: true
// expect: true
// expect: true
// expect: true
// expect: true
