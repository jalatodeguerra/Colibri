struct Job {
    priority: int
    name: str
}

// The user impl wins over the derived field order: the lowest priority number goes last.
impl Ord for Job {
    fn cmp(self, other: Job) -> int {
        return compare(other.priority, self.priority)
    }
}

fn main() {
    var jobs = [Job { priority: 1, name: "a" }, Job { priority: 3, name: "b" }]
    jobs.sort()
    print(jobs[0].name)
    print(Job { priority: 1, name: "x" } < Job { priority: 2, name: "x" })
}
// expect: b
// expect: false
