// A coroutine that is waiting keeps what its frame holds alive. When the program ends the
// coroutine is cancelled, its frame goes, and the cycle it held has no owner left.
class Node {
    name: str
    next: Node? = none
}

fn worker(s: Signal) {
    let a = Node { name: "a" }
    let b = Node { name: "b" }
    a.next = some(b)
    b.next = some(a)
    wait_for(s)
    print("never")
}

fn main() {
    go worker(Signal())
    task.tick(1.0)
    print("main done")
}

// expect: main done
// leaks: Node, Node
