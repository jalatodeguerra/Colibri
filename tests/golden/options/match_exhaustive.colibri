fn describe(o: int?) -> str => match o {
    some(0) => "zero"
    some(n) if n < 0 => "negative"
    some(_) => "positive"
    none => "nothing"
}

fn main() {
    print(describe(some(0)))
    print(describe(some(-4)))
    print(describe(some(4)))
    print(describe(none))
}

// expect: zero
// expect: negative
// expect: positive
// expect: nothing
