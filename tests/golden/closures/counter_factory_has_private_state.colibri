fn make_counter() -> fn() -> int {
    let mut n = 0
    return fn() {
        n += 1
        return n
    }
}

fn main() {
    let a = make_counter()
    let b = make_counter()
    print(a())
    print(a())
    print(b())
    print(a())
    print(b())
}

// expect: 1
// expect: 2
// expect: 1
// expect: 3
// expect: 2
