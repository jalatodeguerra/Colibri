fn main() {
    let nums = [1, 2, 3, 4, 5, 6]
    let evens = nums.filter(fn(n) => n % 2 == 0)
    print(evens)
    let squares = nums.map(fn(n) => n * n)
    print(squares)
    let words = nums.map(fn(n) => "n{n}")
    print(words)
}

// expect: [2, 4, 6]
// expect: [1, 4, 9, 16, 25, 36]
// expect: ["n1", "n2", "n3", "n4", "n5", "n6"]
