fn identity[T](x: T) -> T => x

fn bigger[T: Ord](a: T, b: T) -> T {
    if a > b {
        return a
    }
    return b
}

fn fold_with(xs: List[int], f: fn(int, int) -> int) -> int {
    var acc = xs[0]
    var i = 1
    while i < xs.len() {
        acc = f(acc, xs[i])
        i += 1
    }
    return acc
}

fn main() {
    let f: fn(str) -> str = identity
    print(f("same"))
    print(fold_with([3, 8, 2], bigger))
}

// expect: same
// expect: 8
