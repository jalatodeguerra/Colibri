fn double(x: int) -> int => x * 2
fn inc(x: int) -> int => x + 1

fn apply(f: fn(int) -> int, x: int) -> int => f(x)

fn main() {
    print(apply(double, 5))
    let f = inc
    print(f(1))
    let mut g: fn(int) -> int = double
    print(g(10))
    g = inc
    print(g(10))
}

// expect: 10
// expect: 2
// expect: 20
// expect: 11
