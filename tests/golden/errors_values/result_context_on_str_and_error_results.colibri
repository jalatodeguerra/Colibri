fn a() -> Result[int, str] => err("low level")
fn b() -> Result[int] => err("other")
print(a().context("step a"))
print(b().context("step b"))
print(b().context("step b").context("whole run"))
let fine: Result[int, str] = ok(2)
print(fine.context("never used"))
// expect: err(step a: low level)
// expect: err(step b: other)
// expect: err(whole run: step b: other)
// expect: ok(2)
