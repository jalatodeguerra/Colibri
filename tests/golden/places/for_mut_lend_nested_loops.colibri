// A `for mut` inside a `for mut`, each over its own local.
struct P { x: int, y: int }

fn main() {
    let mut ps = [P { x: 1, y: 0 }, P { x: 2, y: 0 }]
    let mut qs = [P { x: 10, y: 0 }, P { x: 20, y: 0 }, P { x: 30, y: 0 }]
    for mut p in ps {
        for mut q in qs {
            q.y += p.x
            p.y += q.x
        }
        print("{p.y} {qs[0].y} {qs[1].y} {qs[2].y}")
    }
    print("{ps[0].y} {ps[1].y} {qs[0].y} {qs[1].y} {qs[2].y}")
}

// expect: 60 1 1 1
// expect: 60 3 3 3
// expect: 60 60 3 3 3
