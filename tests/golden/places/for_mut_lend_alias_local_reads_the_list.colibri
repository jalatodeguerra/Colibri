// Another local holds the same list, so the body can read it through that name.
struct P { x: int }

fn main() {
    let mut ps = [P { x: 1 }, P { x: 2 }]
    let qs = ps
    for mut p in ps {
        p.x += 10
        print("{qs[0].x} {qs[1].x}")
    }
    print("{qs[0].x} {qs[1].x}")
}

// expect: 1 2
// expect: 11 2
// expect: 11 12
