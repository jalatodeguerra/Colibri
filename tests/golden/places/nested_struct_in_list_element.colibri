struct Pos { x: int, y: int }
struct Enemy { pos: Pos, hp: int }

fn main() {
    let enemies = [Enemy { pos: Pos { x: 0, y: 0 }, hp: 1 }]
    enemies[0].pos.x += 1
    enemies[0].pos.y = 7
    print(enemies[0].pos)
    print(enemies)
}

// expect: Pos { x: 1, y: 7 }
// expect: [Enemy { pos: Pos { x: 1, y: 7 }, hp: 1 }]
