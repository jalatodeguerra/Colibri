// A generic struct instantiated with a class.
class Res { name: str }

impl Drop for Res {
    fn drop(self) {
        print("drop {self.name}")
    }
}
struct Cell2[T] { v: T, n: int }

fn main() {
    let xs = [Cell2 { v: Res { name: "old0" }, n: 0 }, Cell2 { v: Res { name: "old1" }, n: 1 }]
    for mut c in xs {
        c.v = Res { name: "new{c.n}" }
        print("end of trip {c.n}")
    }
    print("after the loop")
}

// expect: end of trip 0
// expect: drop old0
// expect: end of trip 1
// expect: drop old1
// expect: after the loop
// expect: drop new0
// expect: drop new1
