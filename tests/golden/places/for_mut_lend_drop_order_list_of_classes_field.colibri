// A list of classes inside a struct.
class Res { name: str }

impl Drop for Res {
    fn drop(self) {
        print("drop {self.name}")
    }
}
struct Bag { items: List[Res], n: int }

fn main() {
    let mut xs = [Bag { items: [Res { name: "old0" }], n: 0 }, Bag { items: [Res { name: "old1" }], n: 1 }]
    for mut b in xs {
        b.items = []
        print("end of trip {b.n}")
    }
    print("after the loop")
}

// expect: end of trip 0
// expect: drop old0
// expect: end of trip 1
// expect: drop old1
// expect: after the loop
