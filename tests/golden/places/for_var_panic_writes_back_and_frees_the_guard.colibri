struct P { n: int }
let mut ps = [P { n: 1 }, P { n: 2 }, P { n: 3 }]

fn after() {
    print("{ps[0].n} {ps[1].n} {ps[2].n}")
    // The loop's guard is gone: the list can be written again.
    ps[2] = P { n: 30 }
    print(ps[2].n)
}

fn main() {
    defer after()
    for mut p in ps {
        p.n += 10
        if p.n == 12 {
            let zero = p.n - 12
            print(1 / zero)
        }
    }
}

// expect: 11 12 3
// expect: 30
// panic: division by zero
