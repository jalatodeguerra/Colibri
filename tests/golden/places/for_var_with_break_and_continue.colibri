struct E { hp: int }

fn main() {
    var es = [E { hp: 1 }, E { hp: 2 }, E { hp: 3 }, E { hp: 4 }]
    for var e in es {
        if e.hp == 2 {
            continue
        }
        e.hp += 100
        if e.hp == 103 {
            break
        }
    }
    print(es)
}

// expect: [E { hp: 101 }, E { hp: 2 }, E { hp: 103 }, E { hp: 4 }]
