// A closure made before the loop captures the list; the body calls it.
struct P { x: int }

fn main() {
    let ps = [P { x: 1 }, P { x: 2 }]
    let peek = fn() => ps[0].x * 100 + ps[1].x
    for mut p in ps {
        p.x += 10
        print(peek())
    }
    print(peek())
}

// expect: 102
// expect: 1102
// expect: 1112
