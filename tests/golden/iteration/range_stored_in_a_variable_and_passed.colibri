fn sum_range(r: Range[int]) -> int {
    var s = 0
    for i in r {
        s += i
    }
    return s
}

fn main() {
    let r = 1..=4
    print(sum_range(r))
    print(sum_range(0..3))
    var rs: List[Range[int]] = [0..2, 5..7]
    for r in rs {
        print(r)
    }
    print(0..2 == 0..2)
}

// expect: 10
// expect: 3
// expect: 0..2
// expect: 5..7
// expect: true
