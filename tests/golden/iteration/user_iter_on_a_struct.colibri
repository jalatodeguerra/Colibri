struct Countdown {
    n: int
}

impl Iter[int] for Countdown {
    fn next(mut self) -> int? {
        if self.n <= 0 {
            return none
        }
        let v = self.n
        self.n -= 1
        return some(v)
    }
}

fn main() {
    for x in (Countdown { n: 3 }) {
        print(x)
    }
    let mut c = Countdown { n: 2 }
    while let some(x) = c.next() {
        print("manual {x}")
    }
    print(c.n)
}

// expect: 3
// expect: 2
// expect: 1
// expect: manual 2
// expect: manual 1
// expect: 0
