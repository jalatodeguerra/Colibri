fn main() {
    print((0..4).to_list())
    print((1..=3).to_list())
    print((5..5).to_list())
    print((3..1).to_list())
    let r = 2..5
    let xs = r.to_list()
    xs.push(99)
    print(xs)
    print(r.len())
    print((0..3).to_list().map(fn(x) => x * x))
    let top = 9223372036854775806..=9223372036854775807
    print(top.to_list().len())
}

// expect: [0, 1, 2, 3]
// expect: [1, 2, 3]
// expect: []
// expect: []
// expect: [2, 3, 4, 99]
// expect: 3
// expect: [0, 1, 4]
// expect: 2
