interface Shape {
    fn area(self) -> float
    fn name(self) -> str
}

struct Circle { r: float }
struct Rect { w: float, h: float }
class Blob { size: float }

impl Shape for Circle {
    fn area(self) -> float => 3.0 * self.r * self.r
    fn name(self) -> str => "circle"
}

impl Shape for Rect {
    fn area(self) -> float => self.w * self.h
    fn name(self) -> str => "rect"
}

impl Shape for Blob {
    fn area(self) -> float => self.size
    fn name(self) -> str => "blob"
}

fn print_area(s: Shape) {
    print("{s.name()} has area {s.area()}")
}

fn main() {
    print_area(Circle { r: 1.0 })
    print_area(Rect { w: 2.0, h: 2.5 })
    print_area(Blob { size: 7.0 })
}

// expect: circle has area 3.0
// expect: rect has area 5.0
// expect: blob has area 7.0
