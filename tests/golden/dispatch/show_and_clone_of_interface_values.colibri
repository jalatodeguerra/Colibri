interface Shape {
    fn area(self) -> float
    fn name(self) -> str
}

struct Circle { r: float }
struct Rect { w: float, h: float }
class Blob { size: float }

impl Shape for Circle {
    fn area(self) -> float => 3.0 * self.r * self.r
    fn name(self) -> str => "circle"
}

impl Shape for Rect {
    fn area(self) -> float => self.w * self.h
    fn name(self) -> str => "rect"
}

impl Shape for Blob {
    fn area(self) -> float => self.size
    fn name(self) -> str => "blob"
}

fn main() {
    let a: Shape = Circle { r: 1.5 }
    print(a)
    let b = a.clone()
    print(b.name())
    print("{b}")
    let shapes: List[Shape] = [Rect { w: 1.0, h: 2.0 }]
    print(shapes)
}

// expect: Circle { r: 1.5 }
// expect: circle
// expect: Circle { r: 1.5 }
// expect: [Rect { w: 1.0, h: 2.0 }]
