interface Counter {
    fn bump(mut self)
    fn value(self) -> int
}

struct Clicks { n: int }

impl Counter for Clicks {
    fn bump(mut self) { self.n += 1 }
    fn value(self) -> int => self.n
}

fn main() {
    let mut original = Clicks { n: 10 }
    let mut boxed: Counter = original
    boxed.bump()
    boxed.bump()
    print(original.n)
    print(boxed.value())
    let mut other = boxed
    other.bump()
    print(boxed.value())
    print(other.value())
    original.bump()
    print(boxed.value())
}

// expect: 10
// expect: 12
// expect: 12
// expect: 13
// expect: 12
