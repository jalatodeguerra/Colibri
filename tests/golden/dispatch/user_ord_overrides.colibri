struct Version { major: int, minor: int, label: str }

impl Ord for Version {
    fn cmp(self, other: Version) -> int {
        if self.major != other.major { return self.major - other.major }
        return self.minor - other.minor
    }
}

fn newest[T: Ord](a: T, b: T) -> T => if a > b { a } else { b }

fn main() {
    let a = Version { major: 1, minor: 2, label: "a" }
    let b = Version { major: 1, minor: 10, label: "b" }
    print(a < b)
    print(a >= b)
    print(newest(a, b).label)
    print((a, 1) < (b, 0))
}

// expect: true
// expect: false
// expect: b
// expect: true
