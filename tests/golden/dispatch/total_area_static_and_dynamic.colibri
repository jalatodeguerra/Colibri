interface Shape {
    fn area(self) -> float
    fn name(self) -> str
}

struct Circle { r: float }
struct Rect { w: float, h: float }
class Blob { size: float }

impl Shape for Circle {
    fn area(self) -> float => 3.0 * self.r * self.r
    fn name(self) -> str => "circle"
}

impl Shape for Rect {
    fn area(self) -> float => self.w * self.h
    fn name(self) -> str => "rect"
}

impl Shape for Blob {
    fn area(self) -> float => self.size
    fn name(self) -> str => "blob"
}

fn total_area[T: Shape](shapes: List[T]) -> float {
    let mut total = 0.0
    for s in shapes { total += s.area() }
    return total
}

fn dynamic_total(shapes: List[Shape]) -> float {
    let mut total = 0.0
    for s in shapes { total += s.area() }
    return total
}

fn main() {
    print(total_area([Circle { r: 1.0 }, Circle { r: 2.0 }]))
    let mixed: List[Shape] = [Circle { r: 1.0 }, Rect { w: 2.0, h: 3.0 }, Blob { size: 0.5 }]
    print(dynamic_total(mixed))
    print(total_area(mixed))
}

// expect: 15.0
// expect: 9.5
// expect: 9.5
