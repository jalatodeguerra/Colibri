interface Shape {
    fn area(self) -> float
    fn name(self) -> str
}

struct Circle { r: float }
struct Rect { w: float, h: float }
class Blob { size: float }

impl Shape for Circle {
    fn area(self) -> float => 3.0 * self.r * self.r
    fn name(self) -> str => "circle"
}

impl Shape for Rect {
    fn area(self) -> float => self.w * self.h
    fn name(self) -> str => "rect"
}

impl Shape for Blob {
    fn area(self) -> float => self.size
    fn name(self) -> str => "blob"
}

fn main() {
    let shapes: List[Shape] = []
    shapes.push(Circle { r: 2.0 })
    shapes.push(Blob { size: 1.0 })
    shapes.push(Rect { w: 1.0, h: 1.0 })
    for s in shapes {
        print("{s.name()} {s.area()}")
    }
    print(shapes.len())
}

// expect: circle 12.0
// expect: blob 1.0
// expect: rect 1.0
// expect: 3
