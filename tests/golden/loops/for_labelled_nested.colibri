fn main() {
    'outer: for i in 0..4 {
        for j in 0..4 {
            if j == 2 {
                continue 'outer
            }
            if i == 2 {
                break 'outer
            }
            print("{i},{j}")
        }
    }
    print("done")
}

// expect: 0,0
// expect: 0,1
// expect: 1,0
// expect: 1,1
// expect: done
