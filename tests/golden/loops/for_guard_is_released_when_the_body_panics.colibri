let mut xs = [1, 2, 3]

fn after() {
    // The panic left the loop: the list can be written again.
    xs[0] = 10
    print(xs[0])
}

fn main() {
    defer after()
    for x in xs {
        if x == 2 {
            let zero = x - 2
            print(1 / zero)
        }
    }
}

// expect: 10
// panic: division by zero
