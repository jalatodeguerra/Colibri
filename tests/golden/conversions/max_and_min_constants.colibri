fn main() {
    print(i8.MIN)
    print(i8.MAX)
    print(i16.MIN)
    print(i16.MAX)
    print(i32.MIN)
    print(i32.MAX)
    print(i64.MIN)
    print(i64.MAX)
    print(int.MIN)
    print(int.MAX)
    print(u8.MIN)
    print(u8.MAX)
    print(u16.MIN)
    print(u16.MAX)
    print(u32.MIN)
    print(u32.MAX)
    print(u64.MIN)
    print(u64.MAX)
}
