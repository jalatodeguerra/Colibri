fn main() {
    let a: f32 = 0.1
    let b = float(a)
    print(b)
    let c: float = 0.1
    let d = f32(c)
    print(d)
    print(f32(c) == a)
    print(float(a) == c)
    print(f32(1.0e39))
    print(f32(-1.0e39))
    print(f32(1.0e-50))
}
// expect: 0.10000000149011612
// expect: 0.1
// expect: true
// expect: false
// expect: inf
// expect: -inf
// expect: 0.0
