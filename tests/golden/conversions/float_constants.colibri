fn main() {
    print(float.MAX)
    print(float.MIN)
    print(float.EPSILON)
    print(float.INFINITY)
    print(float.NAN.is_nan())
    print(f64.MAX == float.MAX)
    print(f32.EPSILON)
    print(f32.INFINITY)
}
