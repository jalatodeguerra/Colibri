// caps: net
// allow: unused
// A closure written in `send` or in `Shared(..)` crosses to another thread like the closure of
// `task.run`: its captures must be sendable, and what it reaches must not be module state.
import net

let mut counter = 0

fn bump() {
    counter += 1
}

fn mk[T]() -> Channel[T] {
    return Channel[T]()
}

fn senders(conn: net.Conn, jobs: Channel[fn()], n: int) {
    jobs.send(fn() { bump() }) // error: `closure -> bump -> counter` writes `counter`, which belongs to the main thread
    jobs.send(fn() { conn.close() }) // error: `closure.conn` is a `net.Conn`, which cannot be sent to another thread
    jobs.send(fn() { print(n) })
    jobs.send(bump) // error: `bump -> counter` writes `counter`, which belongs to the main thread
    let kept = Shared(fn() { counter += 1 }) // error: `closure -> counter` writes `counter`
    let fine = Shared(fn() => n)
}

fn nothing_to_clone(conn: net.Conn) {
    let ch: Channel[net.Conn] = mk()
    ch.send(conn) // error: the value sent is a `net.Conn`, which cannot be sent to another thread
}

fn main() {}
