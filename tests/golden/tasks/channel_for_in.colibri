// `for x in ch` reads until the channel is closed and empty. Structured values arrive as copies.
struct Point {
    x: int
    y: int
}

fn main() -> Result[()] {
    let ch = Channel[Point]()
    let t = task.run(fn() {
        for i in 0..4 {
            ch.send(Point { x: i, y: i * 10 })
        }
        ch.close()
    })
    let mut total = 0
    for p in ch {
        print("point {p.x} {p.y}")
        total += p.x + p.y
    }
    t.join()?
    print("total = {total}")
    return ok(())
}

// expect: point 0 0
// expect: point 1 10
// expect: point 2 20
// expect: point 3 30
// expect: total = 66
