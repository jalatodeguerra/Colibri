// workers: 1
// A pool of one thread cannot run a task and, at the same time, the task it waits for. The worker
// that joins a task nobody has started runs it itself, so nested tasks cannot deadlock.
fn fib(n: int) -> int {
    if n < 2 {
        return n
    }
    let a = task.run(fn() => fib(n - 1))
    let b = task.run(fn() => fib(n - 2))
    return a.join().expect("a") + b.join().expect("b")
}

fn chain(depth: int) -> int {
    if depth == 0 {
        return 0
    }
    let inner = task.run(fn() => chain(depth - 1))
    return 1 + inner.join().expect("inner")
}

fn main() -> Result[()] {
    let outer = task.run(fn() => fib(10))
    print("fib(10) = {outer.join()?}")
    let c = task.run(fn() => chain(6))
    print("chain(6) = {c.join()?}")
    return ok(())
}

// expect: fib(10) = 55
// expect: chain(6) = 6
