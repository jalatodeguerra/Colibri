// workers: 3
// allow: unused
// `Shared(x)` makes a frozen copy, and `get()` hands every thread its own. Nothing can write to
// that copy: every way of changing a list, a map, a set, a class object or a builder panics with
// the same message, and the program goes on. (Each attempt runs in a task, so that the panic is
// an `err` that the program prints; the main thread's copy is frozen the same way.)
struct Pt {
    x: int
    y: int
}

struct Holder {
    n: int
}

impl Holder {
    fn inc(mut self) {
        self.n += 1
    }
}

class Node {
    v: int
    items: List[int]
    pos: Pt
}

class Counter {
    n: int
}

impl Counter {
    fn bump(self) {
        self.n += 1
    }
}

fn node() -> Node => Node { v: 1, items: [1, 2], pos: Pt { x: 1, y: 2 } }

fn builder() -> StrBuilder {
    let b = StrBuilder()
    b.push("x")
    return b
}

fn attempt(name: str, f: fn()) {
    match task.run(f).join() {
        ok(_) => print("{name}: no panic")
        err(e) => print("{name}: {e.message().split("panicked: ")[1]}")
    }
}

fn main() {
    let xs = Shared([3, 1, 2])
    let m = Shared({"a": 1})
    let s = Shared(Set([1, 2]))
    let n = Shared(node())
    let c = Shared(Counter { n: 1 })
    let h = Shared([Holder { n: 1 }])
    let b = Shared(builder())
    attempt("index set", fn() { let mut v = xs.get(); v[0] = 9 })
    attempt("index compound", fn() { let mut v = xs.get(); v[0] += 1 })
    attempt("push", fn() { let mut v = xs.get(); v.push(4) })
    attempt("pop", fn() { let mut v = xs.get(); let x = v.pop() })
    attempt("insert", fn() { let mut v = xs.get(); v.insert(0, 4) })
    attempt("remove", fn() { let mut v = xs.get(); let x = v.remove(0) })
    attempt("clear", fn() { let mut v = xs.get(); v.clear() })
    attempt("extend", fn() { let mut v = xs.get(); v.extend([4]) })
    attempt("sort", fn() { let mut v = xs.get(); v.sort() })
    attempt("sort_by", fn() { let mut v = xs.get(); v.sort_by(fn(a, b) => a - b) })
    attempt("reverse", fn() { let mut v = xs.get(); v.reverse() })
    attempt("retain", fn() { let mut v = xs.get(); v.retain(fn(x) => x > 1) })
    attempt("dedup", fn() { let mut v = xs.get(); v.dedup() })
    attempt("map set", fn() { let mut v = m.get(); v["a"] = 2 })
    attempt("map add", fn() { let mut v = m.get(); v["b"] = 2 })
    attempt("map compound", fn() { let mut v = m.get(); v["a"] += 1 })
    attempt("map insert", fn() { let mut v = m.get(); v.insert("b", 2) })
    attempt("map remove", fn() { let mut v = m.get(); let x = v.remove("a") })
    attempt("map clear", fn() { let mut v = m.get(); v.clear() })
    attempt("set add", fn() { let mut v = s.get(); v.add(3) })
    attempt("set remove", fn() { let mut v = s.get(); v.remove(1) })
    attempt("set clear", fn() { let mut v = s.get(); v.clear() })
    attempt("field set", fn() { let v = n.get(); v.v = 2 })
    attempt("field compound", fn() { let v = n.get(); v.v += 2 })
    attempt("nested struct field", fn() { let v = n.get(); v.pos.x = 5 })
    attempt("list in an object", fn() { let v = n.get(); v.items.push(3) })
    attempt("method on an object", fn() { c.get().bump() })
    attempt("mut method on an element", fn() { let mut v = h.get(); v[0].inc() })
    attempt("for mut", fn() { let mut v = h.get(); for mut e in v { e.inc() } })
    attempt("builder push", fn() { b.get().push("y") })
    attempt("builder clear", fn() { b.get().clear() })
    // Reading is what a frozen value is for.
    let read = task.run(fn() -> str {
        let v = n.get()
        return "{xs.get()} {m.get()["a"]} {s.get().len()} {v.v} {v.items} {b.get().to_str()}"
    })
    print("read: {read.join().expect("read")}")
}

// expect: index set: cannot modify a frozen value (it came from `Shared`)
// expect: index compound: cannot modify a frozen value (it came from `Shared`)
// expect: push: cannot modify a frozen value (it came from `Shared`)
// expect: pop: cannot modify a frozen value (it came from `Shared`)
// expect: insert: cannot modify a frozen value (it came from `Shared`)
// expect: remove: cannot modify a frozen value (it came from `Shared`)
// expect: clear: cannot modify a frozen value (it came from `Shared`)
// expect: extend: cannot modify a frozen value (it came from `Shared`)
// expect: sort: cannot modify a frozen value (it came from `Shared`)
// expect: sort_by: cannot modify a frozen value (it came from `Shared`)
// expect: reverse: cannot modify a frozen value (it came from `Shared`)
// expect: retain: cannot modify a frozen value (it came from `Shared`)
// expect: dedup: cannot modify a frozen value (it came from `Shared`)
// expect: map set: cannot modify a frozen value (it came from `Shared`)
// expect: map add: cannot modify a frozen value (it came from `Shared`)
// expect: map compound: cannot modify a frozen value (it came from `Shared`)
// expect: map insert: cannot modify a frozen value (it came from `Shared`)
// expect: map remove: cannot modify a frozen value (it came from `Shared`)
// expect: map clear: cannot modify a frozen value (it came from `Shared`)
// expect: set add: cannot modify a frozen value (it came from `Shared`)
// expect: set remove: cannot modify a frozen value (it came from `Shared`)
// expect: set clear: cannot modify a frozen value (it came from `Shared`)
// expect: field set: cannot modify a frozen value (it came from `Shared`)
// expect: field compound: cannot modify a frozen value (it came from `Shared`)
// expect: nested struct field: cannot modify a frozen value (it came from `Shared`)
// expect: list in an object: cannot modify a frozen value (it came from `Shared`)
// expect: method on an object: cannot modify a frozen value (it came from `Shared`)
// expect: mut method on an element: cannot modify a frozen value (it came from `Shared`)
// expect: for mut: cannot modify a frozen value (it came from `Shared`)
// expect: builder push: cannot modify a frozen value (it came from `Shared`)
// expect: builder clear: cannot modify a frozen value (it came from `Shared`)
// expect: read: [3, 1, 2] 1 2 1 [1, 2] x
