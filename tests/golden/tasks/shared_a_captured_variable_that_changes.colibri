// allow: unused
// A closure that changes a variable it captured cannot be put in a `Shared`: its copy would be
// frozen, and the closure would write to it. A closure that only reads what it captured can.
fn main() {
    let base = 10
    let reads = Shared(fn(x: int) => x + base)
    print("reads: {reads.get()(5)}")
    let mut count = 0
    let writes = Shared(fn() { count += 1 })
    print("not reached")
}

// expect: reads: 15
// panic: a `Shared` cannot hold a closure that changes a variable it captured: its copy is frozen
