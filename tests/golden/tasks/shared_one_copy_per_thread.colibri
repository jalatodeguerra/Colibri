// workers: 1
// A `Shared` gives each thread a copy of its own, made on the first `get()` and kept: a second
// `get()` is the same object (a class compares by identity). Tasks run on the same pool of one
// thread, or inline in a task that joins them, and see the same value either way. The program
// prints the same on a pool of three (`shared_one_copy_per_thread_three_workers`).
class Table {
    rows: List[int]
}

fn total(s: Shared[Table]) -> int {
    let mut sum = 0
    for r in s.get().rows {
        sum += r
    }
    return sum
}

fn outer(s: Shared[Table]) -> int {
    // These run beside `outer` or inline in it; either way they read the same graph.
    let a = task.run(fn() => total(s))
    let b = task.run(fn() => s.get().rows.len())
    return a.join().expect("a") * 10 + b.join().expect("b")
}

fn main() {
    let s = Shared(Table { rows: [1, 2, 3, 4] })
    print("same copy twice in main: {s.get() == s.get()}")
    print("same through a clone of the handle: {s.clone().get() == s.get()}")
    let t = task.run(fn() => (s.get() == s.get(), total(s)))
    let (same, sum) = t.join().expect("task")
    print("same copy twice in a task: {same}, total {sum}")
    print("nested: {task.run(fn() => outer(s)).join().expect("outer")}")
    // A thing that was sent back is an ordinary copy, not the frozen one.
    let back = task.run(fn() => s.get()).join().expect("back")
    back.rows.push(5)
    print("changed copy: {back.rows}, shared: {s.get().rows}")
}

// expect: same copy twice in main: true
// expect: same through a clone of the handle: true
// expect: same copy twice in a task: true, total 10
// expect: nested: 104
// expect: changed copy: [1, 2, 3, 4, 5], shared: [1, 2, 3, 4]
