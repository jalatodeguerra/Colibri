// A use of a deprecated function or method warns; the program still runs.
struct Counter { n: int }

impl Counter {
    @deprecated("use bump instead")
    fn increment(mut self) { self.n += 1 }
    fn bump(mut self) { self.n += 1 }
    @deprecated
    fn make() -> Counter => Counter { n: 0 }
}

@deprecated("use add3 instead")
fn add_three(x: int) -> int => x + 3

fn add3(x: int) -> int => x + 3

@deprecated("walks forever")
fn countdown(n: int) -> int {
    if n <= 0 { return 0 }
    return countdown(n - 1) // not reported: the function's own body
}

fn main() {
    let mut c = Counter.make() // warning: `Counter.make` is deprecated
    c.increment() // warning: `Counter.increment` is deprecated: use bump instead
    c.bump()
    print(c.n)
    print(add_three(1)) // warning: `add_three` is deprecated: use add3 instead
    let f = add_three // warning: `add_three` is deprecated: use add3 instead
    print(f(2))
    print(add3(1))
    print(countdown(3)) // warning: `countdown` is deprecated: walks forever
}
// expect: 2
// expect: 4
// expect: 5
// expect: 4
// expect: 0
