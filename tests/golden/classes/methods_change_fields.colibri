class Counter {
    n: int = 0
    log: List[int] = []
}

impl Counter {
    fn bump(self) {
        self.n += 1
        self.log.push(self.n)
    }
    fn total(self) -> int => self.n
    fn make() -> Counter => Counter { }
}

fn main() {
    let c = Counter.make()
    c.bump()
    c.bump()
    c.bump()
    print(c.total())
    print(c.log)
}

// expect: 3
// expect: [1, 2, 3]
