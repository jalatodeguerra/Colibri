fn main() {
    let xs: List[f32] = [0.1, 0.2, 0.25]
    print(xs)
    let t: (f32, u8, u64) = (0.5, 200, 18446744073709551615)
    print(t)
    let o: f32? = some(0.7)
    print(o)
    let u: List[u64] = [1, 18446744073709551615]
    print(u)
}
// expect: [0.1, 0.2, 0.25]
// expect: (0.5, 200, 18446744073709551615)
// expect: some(0.7)
// expect: [1, 18446744073709551615]
