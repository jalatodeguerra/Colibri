fn pair(a: float, b: float) -> (float, float) => (a, b)

fn main() {
    let a: f32 = 0.5
    let f: float = 1.0
    print(f.min(a))
    let o: float? = some(a)
    print(o)
    print(pair(a, a))
    let g = fn(x: float) -> float => x + 1
    print(g(a))
    let m: Map[str, float] = {"k": a}
    print(m)
    let r: Result[float] = ok(a)
    print(r)
    print(a == f)
    print(f != a)
    let xs: List[f32] = [1, 2]
    var s = 0.0
    for x in xs {
        s += x
    }
    print(s)
    let third: f32 = 1.0 / 3.0
    let w: float = third
    print(w)
    print(third + f)
}
// expect: 0.5
// expect: some(0.5)
// expect: (0.5, 0.5)
// expect: 1.5
// expect: {"k": 0.5}
// expect: ok(0.5)
// expect: false
// expect: true
// expect: 3.0
// expect: 0.3333333432674408
// expect: 1.3333333432674408
