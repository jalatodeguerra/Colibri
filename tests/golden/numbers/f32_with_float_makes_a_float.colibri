fn main() {
    let a: f32 = 0.1
    let d: float = 2.0
    print(a * d)
    print(d * a)
    print(a + d)
    print(a < d)
    print(d >= a)
    print(a == 0.1)
    let e = a * d
    let f: float = e
    print(f)
}
