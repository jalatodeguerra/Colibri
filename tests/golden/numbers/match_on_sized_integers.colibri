fn classify(b: u8) -> str {
    return match b {
        0 => "zero"
        1..=9 => "digit"
        10 | 20 | 30 => "round"
        200..=255 => "high"
        _ => "other"
    }
}

fn sign(x: i8) -> int {
    return match x {
        -128..=-1 => -1
        0 => 0
        _ => 1
    }
}

fn main() {
    print(classify(0))
    print(classify(7))
    print(classify(20))
    print(classify(255))
    print(classify(100))
    print(sign(-128))
    print(sign(0))
    print(sign(127))
    let big: u64 = 18446744073709551615
    match big {
        0 => print("none")
        _ => print("some")
    }
}
// expect: zero
// expect: digit
// expect: round
// expect: high
// expect: other
// expect: -1
// expect: 0
// expect: 1
// expect: some
