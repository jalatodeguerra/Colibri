fn main() {
    let big: f32 = 16777216.0
    print(big + 1.0)
    print(big + 2.0)
    let a: f32 = 0.1
    let b: f32 = 0.2
    print(a + b)
    let c: float = 0.1
    let d: float = 0.2
    print(c + d)
    print(a * 3.0)
    print(1.0 / 3.0 * big / big == 1.0 / 3.0)
    let third: f32 = 1.0 / 3.0
    print(third)
}
// expect: 16777216.0
// expect: 16777218.0
// expect: 0.3
// expect: 0.30000000000000004
// expect: 0.3
// expect: true
// expect: 0.33333334
