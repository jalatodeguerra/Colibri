fn main() {
    var seen: Set[u8] = Set([])
    seen.add(200)
    seen.add(7)
    seen.add(200)
    print(seen.len())
    var names: Map[u64, str] = {:}
    names[18446744073709551615] = "max"
    names[0] = "zero"
    print(names[18446744073709551615])
    var xs: List[i32] = [5, -3, 9, 0]
    xs.sort()
    print(xs)
    let ys: List[u64] = [18446744073709551615, 3, 9223372036854775808]
    print(ys.max())
    print(ys.min())
    var z: List[u64] = ys.clone()
    z.sort()
    print(z)
    print(seen.contains(7))
}
// expect: 2
// expect: max
// expect: [-3, 0, 5, 9]
// expect: some(18446744073709551615)
// expect: some(3)
// expect: [3, 9223372036854775808, 18446744073709551615]
// expect: true
