fn main() {
    let xs = [7, -7, 0, 100, 9223372036854775807, -9223372036854775807]
    for x in xs {
        print("{x}: {x * 3} {x / 4} {x % 4} {x / -2} {x % -2} {x == 7} {x != 7} {x == -7}")
    }
}

// expect: 7: 21 1 3 -3 1 true false false
// expect: -7: -21 -1 -3 3 -1 false true true
// expect: 0: 0 0 0 0 0 false true false
// expect: 100: 300 25 0 -50 0 false true false
// panic: integer overflow
