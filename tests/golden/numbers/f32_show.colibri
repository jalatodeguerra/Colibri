fn main() {
    let a: f32 = 0.1
    let b: f32 = 3.4028235e38
    let c: f32 = 1e-7
    let d: f32 = -0.0
    let e: f32 = 16777216
    print(a)
    print(b)
    print(c)
    print(d)
    print(e)
    print(f32.MAX)
    print(f32.MIN)
    print("{a} {b}")
}
// expect: 0.1
// expect: 3.4028235e38
// expect: 1e-7
// expect: -0.0
// expect: 16777216.0
// expect: 3.4028235e38
// expect: -3.4028235e38
// expect: 0.1 3.4028235e38
