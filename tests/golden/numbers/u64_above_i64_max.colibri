fn main() {
    let a: u64 = 9223372036854775808
    let b: u64 = 9223372036854775807
    print(a)
    print(a + b)
    print(a - b)
    print(a / 2)
    print(a % 1000)
    print(a * 1)
    print(a > b)
    print(a == 9223372036854775808)
}
