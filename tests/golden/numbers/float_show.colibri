print(1.0)
print(0.5)
print(100000.0)
print(0.1 + 0.2)
print(1e-9)
print(1.5e300)
print(1e16)
print(123456789.0)
print(-0.0)
print(1.0 / 0.0)
print(-1.0 / 0.0)
print(0.0 / 0.0)
