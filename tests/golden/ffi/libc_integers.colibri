// caps: ffi
// Integers of every width; the process's own symbols need no `@link`.

extern "C" {
    fn abs(x: i32) -> i32
    fn labs(x: int) -> int
    fn llabs(x: int) -> int
    fn htons(x: u16) -> u16
    fn getpid() -> i32
    fn isdigit(c: i32) -> i32
    fn rand() -> i32
    fn srand(seed: u32)
}

fn main() {
    print(abs(-7))
    print(labs(-(1 << 40)))
    print(llabs(-3))
    print(htons(1) == 256 || htons(1) == 1)
    print(getpid() > 0)
    print(isdigit(55) != 0)
    print(isdigit(65) != 0)
    srand(1)
    let first = rand()
    srand(1)
    print(rand() == first)
}
// expect: 7
// expect: 1099511627776
// expect: 3
// expect: true
// expect: true
// expect: true
// expect: false
// expect: true
