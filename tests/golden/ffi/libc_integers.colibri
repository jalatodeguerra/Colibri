// caps: ffi
// Integers of every width; the process's own symbols need no `@link`. The functions only
// Unix has are in libc_posix_integers.colibri (and libc_windows_integers.colibri).

extern "C" {
    fn abs(x: i32) -> i32
    fn labs(x: int) -> int
    fn llabs(x: int) -> int
    fn isdigit(c: i32) -> i32
    fn rand() -> i32
    fn srand(seed: u32)
}

fn main() {
    print(abs(-7))
    print(labs(-(1 << 40)))
    print(llabs(-3))
    print(isdigit(55) != 0)
    print(isdigit(65) != 0)
    srand(1)
    let first = rand()
    srand(1)
    print(rand() == first)
}
// expect: 7
// expect: 1099511627776
// expect: 3
// expect: true
// expect: false
// expect: true
