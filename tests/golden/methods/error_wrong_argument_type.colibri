struct P { x: int }

impl P {
    fn add(self, k: int) -> int => self.x + k
}

fn main() {
    let p = P { x: 1 }
    print(p.add("two")) // error: expected `int`, found `str`
    print(p.add()) // error: missing argument for `k` in the call to `P.add`
    print(p.add(1, 2)) // error: too many arguments: `P.add` takes 1 argument, found 2
}
