struct Bank { balance: int }

impl Bank {
    fn withdraw(mut self, amount: int) -> bool {
        if amount > self.balance {
            return false
        }
        self.balance -= amount
        return true
    }
}

fn main() {
    let mut b = Bank { balance: 50 }
    print(b.withdraw(80))
    print(b.withdraw(30))
    print(b.balance)
}

// expect: false
// expect: true
// expect: 20
