struct Cell { alive: bool }

impl Cell {
    fn toggle(mut self) {
        self.alive = !self.alive
    }
}

fn main() {
    let mut pair = (Cell { alive: false }, Cell { alive: true })
    pair.0.toggle()
    pair.1.toggle()
    print(pair)
}

// expect: (Cell { alive: true }, Cell { alive: false })
