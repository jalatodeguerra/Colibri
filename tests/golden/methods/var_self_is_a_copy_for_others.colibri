struct Counter { n: int }

impl Counter {
    fn inc(var self) {
        self.n += 1
    }
}

fn main() {
    var a = Counter { n: 0 }
    let snapshot = a
    var b = a
    a.inc()
    a.inc()
    b.inc()
    print(a.n)
    print(b.n)
    print(snapshot.n)
}

// expect: 2
// expect: 1
// expect: 0
