struct Counter { n: int }
struct Game { score: Counter, lives: Counter }

impl Counter {
    fn inc(var self) {
        self.n += 1
    }
}

fn main() {
    var g = Game { score: Counter { n: 0 }, lives: Counter { n: 3 } }
    g.score.inc()
    g.score.inc()
    g.lives.inc()
    print(g)
}

// expect: Game { score: Counter { n: 2 }, lives: Counter { n: 4 } }
