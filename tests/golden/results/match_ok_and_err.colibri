fn describe(r: Result[int, str]) -> str {
    return match r {
        ok(0) => "zero"
        ok(n) if n < 0 => "negative {n}"
        ok(n) => "positive {n}"
        err(msg) => "failed: {msg}"
    }
}
print(describe(ok(0)))
print(describe(ok(-4)))
print(describe(ok(9)))
print(describe(err("boom")))
// expect: zero
// expect: negative -4
// expect: positive 9
// expect: failed: boom
