// `ok(x)` and `err(e)` build a `Result`; Show prints the variant and its payload.
let a: Result[int, str] = ok(3)
let b: Result[int, str] = err("bad input")
print(a)
print(b)
print("{a} / {b}")
let nested: Result[Result[int, str], str] = ok(ok(1))
print(nested)
let pair: Result[(int, str), str] = ok((1, "one"))
print(pair)
// expect: ok(3)
// expect: err("bad input")
// expect: ok(3) / err("bad input")
// expect: ok(ok(1))
// expect: ok((1, "one"))
