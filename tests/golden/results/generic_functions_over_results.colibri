fn first_ok[T, E](items: List[Result[T, E]]) -> T? {
    for item in items {
        if let ok(v) = item {
            return some(v)
        }
    }
    return none
}
fn errors[T, E](items: List[Result[T, E]]) -> List[E] {
    let mut out: List[E] = []
    for item in items {
        if let err(e) = item {
            out.push(e)
        }
    }
    return out
}
let rs: List[Result[int, str]] = [err("a"), ok(2), err("b"), ok(4)]
print(first_ok(rs))
print(errors(rs))
let none_ok: List[Result[int, str]] = [err("z")]
print(first_ok(none_ok))
// expect: some(2)
// expect: ["a", "b"]
// expect: none
