// The old `var` is reported with its replacement and then read as `let mut`, so the
// rest of the file is still checked.
struct P { n: int }

impl P {
    fn bump(var self) { // error: `var` is not a Colibri keyword; mutable bindings are written `let mut`
        self.n += 1
    }
}

fn twice(var q: int) -> int { // error: `var` is not a Colibri keyword; mutable bindings are written `let mut`
    q += q
    return q
}

fn main() {
    var x = 1 // error: `var` is not a Colibri keyword; mutable bindings are written `let mut`
    x += 1
    for var e in [1, 2] { // error: `var` is not a Colibri keyword; mutable bindings are written `let mut`
        e += 1
    }
    let f = fn(var k) => k // error: `var` is not a Colibri keyword; mutable bindings are written `let mut`
    let both = true and false // error: `and` is not an operator in Colibri
}
