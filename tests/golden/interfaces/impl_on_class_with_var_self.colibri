interface Counter {
    fn bump(var self)
    fn value(self) -> int
}

class Clicks { n: int }

impl Counter for Clicks {
    fn bump(self) { self.n += 1 }
    fn value(self) -> int => self.n
}

fn bump_twice[C: Counter](c: C) {
    var local = c
    local.bump()
    local.bump()
}

fn main() {
    let c = Clicks { n: 0 }
    bump_twice(c)
    print(c.value())
}

// expect: 2
