// The clock and the random numbers of the standard library come from the page, and only the node
// harness can say what they must be: its clock is virtual (the wait of half a second is exactly
// that long on it, whatever this machine's clock says) and its random bytes are all 0xa5.
// node-only: the clock and the random bytes are the harness's.
// web-max-ticks: 3
import rand
import time

fn main() {
    let t0 = time.now()
    wait(0.5)
    let dt = time.now() - t0
    print("the page's clock moved by half a second: {dt >= 0.5 && dt < 0.6}")
    print("the seed came from the page: {rand.int(0, 1000000)}")
}

// expect: the page's clock moved by half a second: true
// expect: the seed came from the page: 97819
