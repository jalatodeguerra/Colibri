}
impl Show for ivec3 {
    fn show(self) -> str => "ivec3({self.x}, {self.y}, {self.z})"
}

impl ivec3 {
    /// The sum of the products of the components, left to right.
    pub fn dot(self, other: ivec3) -> i32 => self.x * other.x + self.y * other.y + self.z * other.z
    /// The squared length.
    pub fn len_sq(self) -> i32 => self.dot(self)
    /// The length, computed exactly and rounded once.
    pub fn len(self) -> f32 {
        let s = int(self.x) * int(self.x) + int(self.y) * int(self.y) + int(self.z) * int(self.z)
        return f32(float(s).sqrt())
    }
    /// The distance between two points, computed exactly and rounded once.
    pub fn distance(self, other: ivec3) -> f32 {
        let dx = int(self.x) - int(other.x)
        let dy = int(self.y) - int(other.y)
        let dz = int(self.z) - int(other.z)
        let s = dx * dx + dy * dy + dz * dz
        return f32(float(s).sqrt())
    }
    /// Each component made positive; `i32` `MIN` panics.
    pub fn abs(self) -> ivec3 => ivec3 { x: self.x.abs(), y: self.y.abs(), z: self.z.abs() }
    pub fn to_vec(self) -> vec3 => vec3(f32(self.x), f32(self.y), f32(self.z))
    /// The smaller of each pair of components.
    pub fn min(self, other: ivec3) -> ivec3 => ivec3 {
        x: self.x.min(other.x),
        y: self.y.min(other.y),
        z: self.z.min(other.z),
    }
    /// The larger of each pair of components.
    pub fn max(self, other: ivec3) -> ivec3 => ivec3 {
        x: self.x.max(other.x),
        y: self.y.max(other.y),
        z: self.z.max(other.z),
    }
    /// The vector perpendicular to both, by the right-hand rule.
    pub fn cross(self, other: ivec3) -> ivec3 {
        return ivec3 {
            x: self.y * other.z - self.z * other.y,
            y: self.z * other.x - self.x * other.z,
            z: self.x * other.y - self.y * other.x,
        }
    }
    /// The first two components.
    pub fn xy(self) -> ivec2 => ivec2(self.x, self.y)
}

/// A float vector of 4 components, `f32` each; 4 bytes per component, laid out like C.
@repr(C)
pub struct vec4 { pub x: f32, pub y: f32, pub z: f32, pub w: f32 }

/// `vec4(x, y, ..)`: an untyped literal, an `f32` or a `float` is accepted, rounded to `f32`.
pub fn vec4(x: float, y: float, z: float, w: float) -> vec4 => vec4 {
    x: f32(x),
    y: f32(y),
    z: f32(z),
    w: f32(w),
}

impl Add for vec4 {
    fn add(self, other: vec4) -> vec4 => vec4 {
        x: self.x + other.x,
        y: self.y + other.y,
        z: self.z + other.z,
        w: self.w + other.w,
    }
}
impl Sub for vec4 {
    fn sub(self, other: vec4) -> vec4 => vec4 {
        x: self.x - other.x,
        y: self.y - other.y,
        z: self.z - other.z,
        w: self.w - other.w,
    }
}
impl Mul for vec4 {
    // component by component
    fn mul(self, other: vec4) -> vec4 => vec4 {
        x: self.x * other.x,
        y: self.y * other.y,
        z: self.z * other.z,
        w: self.w * other.w,
    }
}
impl Div for vec4 {
    fn div(self, other: vec4) -> vec4 => vec4 {
        x: self.x / other.x,
        y: self.y / other.y,
        z: self.z / other.z,
        w: self.w / other.w,
    }
}
impl Mul[float] for vec4 {
    fn mul(self, s: float) -> vec4 {
        let k = f32(s)
        return vec4 { x: self.x * k, y: self.y * k, z: self.z * k, w: self.w * k }
    }
}
impl Div[float] for vec4 {
    fn div(self, s: float) -> vec4 {
        let k = f32(s)
        return vec4 { x: self.x / k, y: self.y / k, z: self.z / k, w: self.w / k }
    }
}
impl Mul[vec4, vec4] for float {
    fn mul(self, v: vec4) -> vec4 => v * self
}
impl Neg for vec4 {
    fn neg(self) -> vec4 => vec4 { x: -self.x, y: -self.y, z: -self.z, w: -self.w }
}
impl Show for vec4 {
    fn show(self) -> str => "vec4({self.x}, {self.y}, {self.z}, {self.w})"
}

impl vec4 {
    /// The sum of the products of the components, left to right.
    pub fn dot(self, other: vec4) -> f32 => self.x * other.x +
        self.y * other.y +
        self.z * other.z +
        self.w * other.w
    /// The squared length.
    pub fn len_sq(self) -> f32 => self.dot(self)
    /// The length, the square root of `len_sq`.
    pub fn len(self) -> f32 => self.len_sq().sqrt()
    /// The distance between two points.
    pub fn distance(self, other: vec4) -> f32 => (self - other).len()
    /// The vector with the same direction and length 1; the zero vector stays zero.
    pub fn normalize(self) -> vec4 {
        let l = self.len()
        if l == 0.0 {
            return self
        }
        return vec4 { x: self.x / l, y: self.y / l, z: self.z / l, w: self.w / l }
    }
    /// `self + (other - self) * t`
    pub fn lerp(self, other: vec4, t: float) -> vec4 => self + (other - self) * t
    /// Each component truncated toward zero; a `nan` or a value out of range panics.
    pub fn to_ivec(self) -> ivec4 => ivec4(i32(self.x), i32(self.y), i32(self.z), i32(self.w))
    pub fn abs(self) -> vec4 => vec4 {
        x: self.x.abs(),
        y: self.y.abs(),
        z: self.z.abs(),
        w: self.w.abs(),
    }
    /// The smaller of each pair of components.
    pub fn min(self, other: vec4) -> vec4 => vec4 {
        x: self.x.min(other.x),
        y: self.y.min(other.y),
        z: self.z.min(other.z),
        w: self.w.min(other.w),
    }
    /// The larger of each pair of components.
    pub fn max(self, other: vec4) -> vec4 => vec4 {
        x: self.x.max(other.x),
        y: self.y.max(other.y),
        z: self.z.max(other.z),
        w: self.w.max(other.w),
    }
    /// The first two components.
    pub fn xy(self) -> vec2 => vec2(self.x, self.y)
    /// The first three components.
    pub fn xyz(self) -> vec3 => vec3(self.x, self.y, self.z)
}

