impl ivec4 {
    /// The sum of the products of the components, left to right.
    pub fn dot(self, other: ivec4) -> i32 => self.x * other.x +
        self.y * other.y +
        self.z * other.z +
        self.w * other.w
    /// The squared length.
    pub fn len_sq(self) -> i32 => self.dot(self)
    /// The length, computed exactly and rounded once.
    pub fn len(self) -> f32 {
        let s = int(self.x) * int(self.x) +
            int(self.y) * int(self.y) +
            int(self.z) * int(self.z) +
            int(self.w) * int(self.w)
        return f32(float(s).sqrt())
    }
    /// The distance between two points, computed exactly and rounded once.
    pub fn distance(self, other: ivec4) -> f32 {
        let dx = int(self.x) - int(other.x)
        let dy = int(self.y) - int(other.y)
        let dz = int(self.z) - int(other.z)
        let dw = int(self.w) - int(other.w)
        let s = dx * dx + dy * dy + dz * dz + dw * dw
        return f32(float(s).sqrt())
    }
    /// Each component made positive; `i32` `MIN` panics.
    pub fn abs(self) -> ivec4 => ivec4 {
        x: self.x.abs(),
        y: self.y.abs(),
        z: self.z.abs(),
        w: self.w.abs(),
    }
    pub fn to_vec(self) -> vec4 => vec4(f32(self.x), f32(self.y), f32(self.z), f32(self.w))
    /// The smaller of each pair of components.
    pub fn min(self, other: ivec4) -> ivec4 => ivec4 {
        x: self.x.min(other.x),
        y: self.y.min(other.y),
        z: self.z.min(other.z),
        w: self.w.min(other.w),
    }
    /// The larger of each pair of components.
    pub fn max(self, other: ivec4) -> ivec4 => ivec4 {
        x: self.x.max(other.x),
        y: self.y.max(other.y),
        z: self.z.max(other.z),
        w: self.w.max(other.w),
    }
    /// The first two components.
    pub fn xy(self) -> ivec2 => ivec2(self.x, self.y)
    /// The first three components.
    pub fn xyz(self) -> ivec3 => ivec3(self.x, self.y, self.z)
}

/// The unit vector that points `radians` counter-clockwise from the x axis.
pub fn from_angle(radians: f32) -> vec2 => vec2(math.cos(radians), math.sin(radians))

/// The angle of a vector from the x axis, in radians, in `-PI..=PI` (`0` for the zero vector).
pub fn angle(v: vec2) -> f32 => f32(math.atan2(v.y, v.x))
