import httpd_impl

test "get finds a name without regard to case" {
    let h = httpd_impl.Headers()
    h.set("Content-Type", "text/plain")
    assert_eq(h.get("content-type"), some("text/plain"))
    assert_eq(h.get("CONTENT-TYPE"), some("text/plain"))
    assert_eq(h.get("Content-Type"), some("text/plain"))
    assert_eq(h.get("content-length"), none)
}

test "has is case-insensitive too" {
    let h = httpd_impl.Headers()
    h.add("X-Thing", "1")
    assert(h.has("x-thing"))
    assert(h.has("X-THING"))
    assert(!h.has("x-other"))
}

test "get joins the values of a name with a comma and a space, in order" {
    let h = httpd_impl.Headers()
    h.add("Accept", "text/html")
    h.add("accept", "application/json")
    h.add("ACCEPT", "*/*")
    assert_eq(h.get("accept"), some("text/html, application/json, */*"))
}

test "get joins the values of set-cookie with a newline, whatever the case of the name" {
    let h = httpd_impl.Headers()
    h.add("Set-Cookie", "a=1; Expires=Wed, 21 Oct 2026 07:28:00 GMT")
    h.add("set-cookie", "b=2")
    let want = some("a=1; Expires=Wed, 21 Oct 2026 07:28:00 GMT\nb=2")
    assert_eq(h.get("set-cookie"), want)
    assert_eq(h.get("SET-COOKIE"), want)
}

test "get_all keeps the lines apart, in order" {
    let h = httpd_impl.Headers()
    h.add("Set-Cookie", "a=1; Path=/")
    h.add("Set-Cookie", "b=2, c=3")
    assert_eq(h.get_all("set-cookie"), ["a=1; Path=/", "b=2, c=3"])
    assert_eq(h.get_all("missing"), [])
}

test "get_all gives a copy that cannot change the headers" {
    let h = httpd_impl.Headers()
    h.add("A", "1")
    let all = h.get_all("a")
    all.push("2")
    assert_eq(h.get_all("a"), ["1"])
}

test "set replaces every value of the name" {
    let h = httpd_impl.Headers()
    h.add("A", "1")
    h.add("a", "2")
    h.set("A", "3")
    assert_eq(h.get_all("a"), ["3"])
    assert_eq(h.len(), 1)
}

test "add keeps what is there" {
    let h = httpd_impl.Headers()
    h.set("A", "1")
    h.add("A", "2")
    assert_eq(h.get_all("a"), ["1", "2"])
    assert_eq(h.len(), 2)
}

test "remove takes every value of the name, and a name that is not there is fine" {
    let h = httpd_impl.Headers()
    h.add("A", "1")
    h.add("A", "2")
    h.add("B", "3")
    h.remove("a")
    assert(!h.has("a"))
    assert_eq(h.get("a"), none)
    assert_eq(h.names(), ["b"])
    h.remove("never-there")
    assert_eq(h.len(), 1)
}

test "names are lower case, in the order each was first set or added" {
    let h = httpd_impl.Headers()
    h.add("Zebra", "1")
    h.add("Apple", "2")
    h.add("zebra", "3")
    h.set("Mango", "4")
    assert_eq(h.names(), ["zebra", "apple", "mango"])
}

test "len counts field lines, not names" {
    let h = httpd_impl.Headers()
    assert_eq(h.len(), 0)
    h.add("A", "1")
    h.add("A", "2")
    h.add("B", "3")
    assert_eq(h.len(), 3)
    assert_eq(h.names().len(), 2)
}

test "the lines come as they were first spelled" {
    let h = httpd_impl.Headers()
    h.add("Content-Type", "x")
    h.add("content-type", "y")
    h.add("ETag", "z")
    assert_eq(h.lines(), [("Content-Type", "x"), ("Content-Type", "y"), ("ETag", "z")])
}

test "an empty value is a value" {
    let h = httpd_impl.Headers()
    h.add("A", "")
    assert_eq(h.get("a"), some(""))
    assert(h.has("a"))
}

test "two Headers do not share their lines" {
    let a = httpd_impl.Headers()
    let b = httpd_impl.Headers()
    a.add("X", "1")
    assert(!b.has("x"))
}
