import common
import httpd_impl
import str

fn with(fields: List[str]) -> Result[httpd_impl.Head, httpd_impl.Reject] {
    return common.head_of("POST /x HTTP/1.1", fields)
}

fn old_with(fields: List[str]) -> Result[httpd_impl.Head, httpd_impl.Reject] {
    let lines = ["POST /x HTTP/1.0"]
    lines.extend(fields)
    return common.head(lines)
}

fn is_length(r: Result[httpd_impl.Head, httpd_impl.Reject], n: int) -> bool {
    return match common.accepted(r).framing {
        Length(m) => m == n
        _ => false
    }
}

fn is_chunked(r: Result[httpd_impl.Head, httpd_impl.Reject]) -> bool {
    return match common.accepted(r).framing {
        Chunked => true
        _ => false
    }
}

fn is_no_body(r: Result[httpd_impl.Head, httpd_impl.Reject]) -> bool {
    return match common.accepted(r).framing {
        NoBody => true
        _ => false
    }
}

// ---- Content-Length ----

test "a Content-Length of digits is the length of the body" {
    assert(is_length(with(["Content-Length: 5"]), 5))
    assert(is_length(with(["Content-Length: 0"]), 0))
    assert(is_length(with(["content-length: 12"]), 12))
    assert(is_length(with(["Content-Length: 007"]), 7))
}

test "no Content-Length and no Transfer-Encoding is no body" {
    assert(is_no_body(with([])))
    assert(is_no_body(common.head(["GET / HTTP/1.1", "Host: x"])))
}

test "Content-Length given twice is 400 whether the values are equal or not" {
    // two lines, the same value
    assert_eq(common.status_of(with(["Content-Length: 5", "Content-Length: 5"])), 400)
    // two lines, different values
    assert_eq(common.status_of(with(["Content-Length: 5", "Content-Length: 6"])), 400)
    assert_eq(common.status_of(with(["Content-Length: 6", "Content-Length: 5"])), 400)
    // one line with a list, the same value
    assert_eq(common.status_of(with(["Content-Length: 5, 5"])), 400)
    assert_eq(common.status_of(with(["Content-Length: 5,5"])), 400)
    // one line with a list, different values
    assert_eq(common.status_of(with(["Content-Length: 5, 6"])), 400)
    // a list with an empty element
    assert_eq(common.status_of(with(["Content-Length: 5,"])), 400)
    assert_eq(common.status_of(with(["Content-Length: ,5"])), 400)
    assert(common.why_of(with(["Content-Length: 5, 5"])).contains("more than once"))
    assert(common.why_of(with(["Content-Length: 5", "Content-Length: 5"])).contains("more than once"))
}

test "a Content-Length that is not plain digits is 400" {
    assert_eq(common.status_of(with(["Content-Length: +5"])), 400)
    assert_eq(common.status_of(with(["Content-Length: -5"])), 400)
    assert_eq(common.status_of(with(["Content-Length: 0x5"])), 400)
    assert_eq(common.status_of(with(["Content-Length: 5a"])), 400)
    assert_eq(common.status_of(with(["Content-Length: a5"])), 400)
    assert_eq(common.status_of(with(["Content-Length: 5.0"])), 400)
    assert_eq(common.status_of(with(["Content-Length: 5 5"])), 400)
    assert_eq(common.status_of(with(["Content-Length: 1e3"])), 400)
    assert_eq(common.status_of(with(["Content-Length:"])), 400)
    assert_eq(common.status_of(with(["Content-Length: \u{663}"])), 400)
}

test "parse_cl takes digits only, and no whitespace either" {
    let g = httpd_impl.grammar()
    assert_eq(httpd_impl.parse_cl(g, [" 5 "]).is_err(), true)
    assert_eq(httpd_impl.parse_cl(g, [" 5"]).is_err(), true)
    assert_eq(httpd_impl.parse_cl(g, ["5 "]).is_err(), true)
    assert_eq(httpd_impl.parse_cl(g, ["5"]).is_ok(), true)
}

test "parse_cl: none without a line, and a number with one" {
    let g = httpd_impl.grammar()
    assert_eq(httpd_impl.parse_cl(g, []) or none, none)
    assert_eq(httpd_impl.parse_cl(g, ["42"]) or none, some(42))
}

test "a Content-Length of 18 digits is accepted and 19 digits are 400" {
    assert(is_length(with(["Content-Length: 999999999999999999"]), 999999999999999999))
    assert_eq(common.status_of(with(["Content-Length: 1000000000000000000"])), 400)
    assert_eq(common.status_of(with(["Content-Length: 9999999999999999999"])), 400)
    assert_eq(common.status_of(with(["Content-Length: 99999999999999999999999999"])), 400)
    // a long run of zeros is as long as it is written
    assert_eq(common.status_of(with(["Content-Length: 0000000000000000005"])), 400)
}

// ---- Transfer-Encoding ----

test "chunked is accepted, in any case" {
    assert(is_chunked(with(["Transfer-Encoding: chunked"])))
    assert(is_chunked(with(["Transfer-Encoding: Chunked"])))
    assert(is_chunked(with(["transfer-encoding: CHUNKED"])))
}

test "chunked with SP and HTAB around it is accepted" {
    assert(is_chunked(with(["Transfer-Encoding:  chunked \t"])))
    assert(is_chunked(with(["Transfer-Encoding:\tchunked"])))
}

test "an empty element of the list is 400, wherever it is" {
    assert_eq(common.status_of(with(["Transfer-Encoding: chunked,"])), 400)
    assert_eq(common.status_of(with(["Transfer-Encoding: , chunked"])), 400)
    assert_eq(common.status_of(with(["Transfer-Encoding: , , chunked , ,"])), 400)
    assert_eq(common.status_of(with(["Transfer-Encoding: ,,chunked"])), 400)
    assert_eq(common.status_of(with(["Transfer-Encoding: chunked , "])), 400)
    assert_eq(common.status_of(with(["Transfer-Encoding: gzip,,chunked"])), 400)
}

test "a second Transfer-Encoding line, empty or not, is 400" {
    assert_eq(common.status_of(with(["Transfer-Encoding:", "Transfer-Encoding: chunked"])), 400)
    assert_eq(common.status_of(with(["Transfer-Encoding: chunked", "Transfer-Encoding:"])), 400)
    assert_eq(common.status_of(with(["Transfer-Encoding: chunked", "Transfer-Encoding: chunked"])), 400)
    assert_eq(common.status_of(with(["Transfer-Encoding: gzip", "Transfer-Encoding: chunked"])), 400)
}

test "parameters, quotes, and a coding that is not a token are 400" {
    assert_eq(common.status_of(with(["Transfer-Encoding: chunked;q=1"])), 400)
    assert_eq(common.status_of(with(["Transfer-Encoding: chunked; x"])), 400)
    assert_eq(common.status_of(with(["Transfer-Encoding: \"chunked\""])), 400)
    assert_eq(common.status_of(with(["Transfer-Encoding: xchunked"])), 400)
    assert_eq(common.status_of(with(["Transfer-Encoding: chunked x"])), 400)
}

test "Unicode white space around chunked is not white space: 400" {
    assert_eq(common.status_of(with(["Transfer-Encoding: chunked\u{a0}"])), 400)
    assert_eq(common.status_of(with(["Transfer-Encoding: \u{a0}chunked"])), 400)
    assert_eq(common.status_of(with(["Transfer-Encoding: \u{2003}chunked"])), 400)
    assert_eq(common.status_of(with(["Transfer-Encoding: chunked\u{2003}"])), 400)
    assert_eq(common.status_of(with(["Transfer-Encoding: gzip,\u{a0}chunked"])), 400)
}

test "a letter that only lower-cases to one of the letters of chunked is not chunked" {
    // KELVIN SIGN lower-cases to `k`.
    assert_eq(common.status_of(with(["Transfer-Encoding: chun\u{212a}ed"])), 400)
}

test "more than eight codings is 400, however long the list" {
    assert_eq(common.status_of(with(["Transfer-Encoding: a,b,c,d,e,f,g,chunked"])), 501)
    assert_eq(common.status_of(with(["Transfer-Encoding: a,b,c,d,e,f,g,h,chunked"])), 400)
    assert_eq(common.status_of(with(["Transfer-Encoding: " + str.repeat(",", 60000)])), 400)
}

test "chunked given on two lines is chunked twice and is 400" {
    assert_eq(common.status_of(with(["Transfer-Encoding: chunked", "Transfer-Encoding: chunked"])), 400)
    assert_eq(common.status_of(with(["Transfer-Encoding: chunked, chunked"])), 400)
    assert_eq(common.status_of(with(["Transfer-Encoding: gzip, chunked, chunked"])), 400)
    assert_eq(common.status_of(with(["Transfer-Encoding: chunked, gzip, chunked"])), 400)
}

test "a coding before chunked is not supported: 501" {
    assert_eq(common.status_of(with(["Transfer-Encoding: gzip, chunked"])), 501)
    assert_eq(common.status_of(with(["Transfer-Encoding: identity, chunked"])), 501)
    assert_eq(common.status_of(with(["Transfer-Encoding: deflate, gzip, chunked"])), 501)
}

test "chunked that is not last, or absent, is 400" {
    assert_eq(common.status_of(with(["Transfer-Encoding: chunked, gzip"])), 400)
    assert_eq(common.status_of(with(["Transfer-Encoding: gzip"])), 400)
    assert_eq(common.status_of(with(["Transfer-Encoding: identity"])), 400)
    assert_eq(common.status_of(with(["Transfer-Encoding: chunked", "Transfer-Encoding: gzip"])), 400)
}

test "an empty Transfer-Encoding, or one of only commas, is 400" {
    assert_eq(common.status_of(with(["Transfer-Encoding:"])), 400)
    assert_eq(common.status_of(with(["Transfer-Encoding: ,"])), 400)
    assert_eq(common.status_of(with(["Transfer-Encoding: , ,"])), 400)
}

test "a coding with parameters, or that is not a token, is 400" {
    assert_eq(common.status_of(with(["Transfer-Encoding: chunked;x=1"])), 400)
    assert_eq(common.status_of(with(["Transfer-Encoding: chunked; q=1"])), 400)
    assert_eq(common.status_of(with(["Transfer-Encoding: chunked x"])), 400)
    assert_eq(common.status_of(with(["Transfer-Encoding: \"chunked\""])), 400)
    assert_eq(common.status_of(with(["Transfer-Encoding: chun ked"])), 400)
    assert_eq(common.status_of(with(["Transfer-Encoding: (chunked)"])), 400)
}

test "parse_te is true for a list that is exactly chunked" {
    let g = httpd_impl.grammar()
    assert_eq(httpd_impl.parse_te(g, ["chunked"]) or false, true)
    assert_eq(httpd_impl.parse_te(g, []) or true, false)
}

// ---- both, and HTTP/1.0 ----

test "Transfer-Encoding with Content-Length is 400, in either order" {
    assert_eq(common.status_of(with(["Transfer-Encoding: chunked", "Content-Length: 5"])), 400)
    assert_eq(common.status_of(with(["Content-Length: 5", "Transfer-Encoding: chunked"])), 400)
    assert_eq(common.status_of(with(["Content-Length: 0", "Transfer-Encoding: chunked"])), 400)
    assert(common.why_of(with(["Content-Length: 5", "Transfer-Encoding: chunked"])).contains("both"))
}

test "Transfer-Encoding with Content-Length is 400 also when the coding would be refused anyway" {
    assert_eq(common.status_of(with(["Transfer-Encoding: gzip, chunked", "Content-Length: 5"])), 400)
    assert_eq(common.status_of(with(["Transfer-Encoding: identity", "Content-Length: 5"])), 400)
}

test "Transfer-Encoding in an HTTP/1.0 request is 400" {
    assert_eq(common.status_of(old_with(["Transfer-Encoding: chunked"])), 400)
    assert_eq(common.status_of(old_with(["Transfer-Encoding: chunked", "Content-Length: 5"])), 400)
    assert_eq(common.status_of(old_with(["Transfer-Encoding: gzip"])), 400)
}

test "Content-Length in an HTTP/1.0 request is accepted" {
    assert(is_length(old_with(["Content-Length: 5"]), 5))
}

// ---- Expect ----

test "Expect: 100-continue is noted when the request has a body" {
    assert(common.accepted(with(["Content-Length: 5", "Expect: 100-continue"])).expect_continue)
    assert(common.accepted(with(["Expect: 100-continue", "Transfer-Encoding: chunked"])).expect_continue)
    assert(common.accepted(with(["Content-Length: 5", "Expect: 100-Continue"])).expect_continue)
}

test "Expect: 100-continue with no body is not waited for" {
    assert(!common.accepted(with(["Expect: 100-continue"])).expect_continue)
    assert(!common.accepted(with(["Content-Length: 0", "Expect: 100-continue"])).expect_continue)
}

test "without Expect there is nothing to continue" {
    assert(!common.accepted(with(["Content-Length: 5"])).expect_continue)
}

test "an Expect of another value is 417" {
    assert_eq(common.status_of(with(["Content-Length: 5", "Expect: foo"])), 417)
    assert_eq(common.status_of(with(["Content-Length: 5", "Expect: 100-continue, 100-continue"])), 417)
    assert_eq(common.status_of(with(["Expect: 100-continues"])), 417)
    assert_eq(common.status_of(with(["Expect:"])), 417)
}

test "Expect is ignored in an HTTP/1.0 request" {
    assert_eq(common.status_of(old_with(["Content-Length: 5", "Expect: foo"])), 0)
    assert(!common.accepted(old_with(["Content-Length: 5", "Expect: 100-continue"])).expect_continue)
}

// ---- persistence ----

test "HTTP/1.1 keeps the connection alive unless it says close" {
    assert(common.accepted(common.head_of("GET / HTTP/1.1", [])).keep_alive)
    assert(!common.accepted(common.head_of("GET / HTTP/1.1", ["Connection: close"])).keep_alive)
    assert(!common.accepted(common.head_of("GET / HTTP/1.1", ["Connection: Close"])).keep_alive)
    assert(!common.accepted(common.head_of("GET / HTTP/1.1", ["Connection: keep-alive, close"])).keep_alive)
    assert(!common.accepted(common.head_of("GET / HTTP/1.1", ["Connection: upgrade", "Connection: close"])).keep_alive)
    assert(common.accepted(common.head_of("GET / HTTP/1.1", ["Connection: keep-alive"])).keep_alive)
}

test "a close token is a token, not a part of a word" {
    assert(common.accepted(common.head_of("GET / HTTP/1.1", ["Connection: closed"])).keep_alive)
    assert(common.accepted(common.head_of("GET / HTTP/1.1", ["Connection: x-close"])).keep_alive)
}

test "HTTP/1.0 closes unless it asks to keep alive, and close wins" {
    assert(!common.accepted(common.head(["GET / HTTP/1.0"])).keep_alive)
    assert(common.accepted(common.head(["GET / HTTP/1.0", "Connection: keep-alive"])).keep_alive)
    assert(common.accepted(common.head(["GET / HTTP/1.0", "Connection: Keep-Alive"])).keep_alive)
    assert(!common.accepted(common.head(["GET / HTTP/1.0", "Connection: keep-alive, close"])).keep_alive)
    assert(!common.accepted(common.head(["GET / HTTP/1.0", "Connection: close"])).keep_alive)
}

test "a Content-Length that is not plain ASCII digits is 400, whatever the digits look like" {
    // The outcome is what counts: it must not depend on how a number is parsed.
    assert_eq(common.status_of(with(["Content-Length: 5 5"])), 400)
    assert_eq(common.status_of(with(["Content-Length: \u{a0}5"])), 400)
    assert_eq(common.status_of(with(["Content-Length: 5\u{a0}"])), 400)
    assert_eq(common.status_of(with(["Content-Length: \u{663}"])), 400)
    assert_eq(common.status_of(with(["Content-Length: \u{ff15}"])), 400)
}

fn keeps(version: str, fields: List[str]) -> bool {
    let lines = ["GET / {version}"]
    if version == "HTTP/1.1" {
        lines.push("Host: x")
    }
    lines.extend(fields)
    return common.accepted(common.head(lines)).keep_alive
}

test "close is found as a token wherever it stands in the list, with white space around it" {
    assert(!keeps("HTTP/1.1", ["Connection: upgrade, close"]))
    assert(!keeps("HTTP/1.1", ["Connection: close, upgrade"]))
    assert(!keeps("HTTP/1.1", ["Connection: a , close ,b"]))
    assert(!keeps("HTTP/1.1", ["Connection:\tclose\t"]))
    assert(!keeps("HTTP/1.1", ["Connection: CLOSE"]))
    assert(!keeps("HTTP/1.1", ["Connection: cLoSe"]))
    assert(!keeps("HTTP/1.1", ["Connection: keep-alive", "Connection: Close"]))
}

test "a token that only contains close, or a letter that folds to one, is not close" {
    assert(keeps("HTTP/1.1", ["Connection: closed"]))
    assert(keeps("HTTP/1.1", ["Connection: x-close"]))
    assert(keeps("HTTP/1.1", ["Connection: close-x"]))
    assert(keeps("HTTP/1.1", ["Connection: xclose"]))
    assert(keeps("HTTP/1.1", ["Connection: clos"]))
    // LATIN SMALL LETTER LONG S folds to `s` in a case-insensitive Unicode match.
    assert(keeps("HTTP/1.1", ["Connection: clo\u{17f}e"]))
    assert(keeps("HTTP/1.1", ["Connection: close\u{a0}"]))
    assert(keeps("HTTP/1.1", ["Connection: \u{a0}close"]))
}

test "keep-alive is a token in the same way, and close beats it" {
    assert(keeps("HTTP/1.0", ["Connection: upgrade, keep-alive"]))
    assert(keeps("HTTP/1.0", ["Connection: KEEP-ALIVE"]))
    assert(keeps("HTTP/1.0", ["Connection: a,\tkeep-alive\t,b"]))
    assert(!keeps("HTTP/1.0", ["Connection: keep-alives"]))
    assert(!keeps("HTTP/1.0", ["Connection: x-keep-alive"]))
    assert(!keeps("HTTP/1.0", ["Connection: keep-aliv\u{17f}e"]))
    assert(!keeps("HTTP/1.0", ["Connection: keep-alive, close"]))
    assert(!keeps("HTTP/1.0", []))
}

test "a long Connection value is read with the same few calls: a list of 30000 tokens" {
    let tokens = str.repeat("a,", 30000)
    assert(keeps("HTTP/1.1", ["Connection: " + tokens + "x"]))
    assert(!keeps("HTTP/1.1", ["Connection: " + tokens + "close"]))
    assert(keeps("HTTP/1.0", ["Connection: " + tokens + "keep-alive"]))
}
