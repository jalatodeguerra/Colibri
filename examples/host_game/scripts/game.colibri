// Gameplay for the host_game example. The host owns the world; this script decides what happens.
// Check it against the host API with:
//   colibri check --interface examples/host_game/scripts/host.cbi examples/host_game/scripts/game.colibri

enum Kind {
    Runner
    Brute
}

class Grunt {
    enemy: Enemy
    kind: Kind
}

var score = 0
var spawned = 0
var grunts: List[Grunt] = []

fn get_score() -> int => score

fn speed(kind: Kind) -> f32 {
    match kind {
        .Runner => return 2.5
        .Brute  => return 1.5
    }
}

fn points(kind: Kind) -> int {
    match kind {
        .Runner => return 10
        .Brute  => return 25
    }
}

fn spawn_one() {
    // Every fifth enemy asks for a spawn point the host does not have; `or` supplies a default.
    let at = spawn_point(spawned % 5) or Vec2 { x: 6.0, y: 6.0 }
    let kind = if spawned % 3 == 2 { Kind.Brute } else { Kind.Runner }
    spawned += 1
    grunts.push(Grunt { enemy: spawn_enemy(at), kind: kind })
}

fn schedule_spawns(every: f32) {
    on_timer(every, fn() {
        spawn_one()
        schedule_spawns(every)
    })
}

fn report_every(secs: f32) {
    on_timer(secs, fn() {
        log("score {score}, {enemies().len()} enemies alive")
        report_every(secs)
    })
}

fn init() {
    log("init")
    schedule_spawns(0.75)
    report_every(2.0)
}

fn update(dt: f32) {
    for g in grunts {
        let e = g.enemy
        if !e.alive() {
            continue
        }
        e.set_pos(move_toward(e.pos(), player(), speed(g.kind) * dt))
        if distance(e.pos(), player()) < 0.5 {
            score -= 5
            log("enemy #{e.id()} reached the player")
            despawn(e) or log("could not despawn an enemy")
        }
    }
    grunts = grunts.filter(fn(g) => g.enemy.alive())
}

fn on_hit(e: Enemy, dmg: int) {
    if e.hp() > 0 {
        return
    }
    for g in grunts {
        if g.enemy == e {
            score += points(g.kind)
            log("enemy #{e.id()} died, score {score}")
        }
    }
    despawn(e) or log("could not despawn an enemy")
}
