import native

fn width_of(table: native.Table, column: int) -> int => table.column_width(column)

test "the width counts terminal columns, not characters" {
    assert_eq(native.display_width("abc"), 3)
    assert_eq(native.display_width("東京"), 4)
    assert_eq(native.display_width("e\u{301}"), 1)
}

test "a grapheme is what a reader sees as one character" {
    assert_eq(native.graphemes("e\u{301}x").len(), 2)
    assert_eq(native.graphemes("日本").len(), 2)
}

test "a Rust Err is an err" {
    match native.pad("東京東京", 4) {
        ok(_)  => panic("text wider than the width should not fit")
        err(e) => assert(e.message().contains("8 columns wide"))
    }
    match native.pad("ab", 4) {
        ok(padded) => assert_eq(padded, "ab  ")
        err(e)     => panic(e.message())
    }
}

test "the table keeps its rows on the Rust side" {
    let table = native.Table.new(["a", "b"])
    assert_eq(table.row_count(), 0)
    match table.add_row(["x", "yy"]) {
        ok(n)  => assert_eq(n, 1)
        err(e) => panic(e.message())
    }
    match table.add_row(["only one"]) {
        ok(_)  => panic("a short row should be refused")
        err(e) => assert(e.message().contains("1 cells in a table of 2 columns"))
    }
    assert_eq(table.row_count(), 1)
    assert_eq(table.column_width(1), 2)
}

test "a panic in Rust is caught by join_result" {
    let table = native.Table.new(["a"])
    match (go width_of(table, 5)).join_result() {
        ok(_)  => panic("a column that is not there should panic")
        err(e) => assert(e.message().contains("index out of bounds"))
    }
}
